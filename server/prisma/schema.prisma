// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pgcrypto]
}

// =====================================================================
// APS — Phase 2 : Socle technique — Référentiel pays/ville & IAM
//
// Le référentiel pays/ville et l'IAM portent l'identité unique et le
// paramétrage géographique utilisés par tous les modules métier. Tant
// qu'ils ne sont pas stables, aucun module de la Phase 3 ne peut être
// branché sans risque de refonte.
// =====================================================================

// -----------------------------------------------------------------
// Enums
// -----------------------------------------------------------------

enum StatutActivationPays {
  pilote
  actif
  inactif
}

enum StatutCompte {
  actif
  suspendu
}

enum StatutVerificationMedecin {
  non_publie
  en_cours
  publie
}

enum StatutRefreshToken {
  actif
  revoque
  expire
}

enum MotifRevocation {
  deconnexion
  changement_mdp
  compromission
  admin
}

// v6 : porté par structure_sante elle-même (auparavant hébergé par le
// supertype "service", supprimé). Même patron que sur medecin.
enum StatutVerificationStructure {
  non_publie
  en_cours
  publie
}

enum TypeStructure {
  clinique
  hopital
  centre_medical
  dispensaire
  laboratoire
}

// Même patron que StatutVerificationStructure / StatutVerificationMedecin —
// voir pharmacie.controller.js.
enum StatutVerificationPharmacie {
  non_publie
  en_cours
  publie
}

// -----------------------------------------------------------------
// Enums — sous-modules Pharmacie (diagramme 03_pharmacie_gardes)
// -----------------------------------------------------------------

// Même patron de modération que StatutVerificationPharmacie : un avis
// déposé n'est jamais visible publiquement avant validation par un
// admin/superadmin — voir avisPharmacie.controller.js.
enum StatutModerationAvis {
  en_attente
  publie
  rejete
}

enum StatutAbonnementPharmacie {
  actif
  expire
  annule
}

// Même patron que StatutModerationAvis : une publicité soumise reste
// "en_attente" tant qu'un admin/superadmin ne l'a pas validée — voir
// publicite.controller.js.
//
// v8 : ces deux enums appartiennent désormais au module autonome
// "Présence, publicité & boost commercial" (diagramme
// 09_presence_publicite_boost). Ce module n'a plus AUCUNE dépendance
// vers Pharmacie (ni vers aucun autre module métier) : une publicité
// est portée directement par un utilisateur et un pays, jamais par une
// fiche annuaire — voir publicite.controller.js.
enum StatutModerationPublicite {
  en_attente
  validee
  rejetee
}

// Cycle d'une réservation d'espace publicitaire (v9). statut_moderation
// est conservé et tenu à jour pour les anciens clients ; la diffusion ne
// dépend QUE de ce statut (payee) et de la période.
enum StatutPublicite {
  en_moderation // soumise par l'annonceur, en attente de l'administration
  rejetee // refusée (motif_rejet envoyé par WhatsApp)
  en_attente_paiement // acceptée : la place est bloquée jusqu'à date_limite_paiement
  expiree // acceptée mais non payée à temps : la place est libérée
  payee // payée : diffusée de date_debut à date_fin (exclue)
  annulee // retirée par l'annonceur avant paiement
}

enum StatutPlanningGarde {
  brouillon
  publie
  expire
  annule
}

// -----------------------------------------------------------------
// Enums — Annuaire assurances (diagramme 08_annuaire_assurances, v8)
// -----------------------------------------------------------------

// Même patron que StatutVerificationStructure / StatutVerificationMedecin
// / StatutVerificationPharmacie : une fiche assurance nouvellement créée
// n'est publique qu'après validation par un admin/superadmin.
enum StatutVerificationAssurance {
  non_publie
  en_cours
  publie
}

// Distingue une compagnie d'assurance d'un courtier (intermédiaire),
// cf. maquette "Annuaire assurances (v8)".
enum TypeActeurAssurance {
  compagnie
  courtier
}

// -----------------------------------------------------------------
// Enums — Module transverse : Gestion des médecins
// (diagramme APS — Module transverse : Gestion des médecins)
// -----------------------------------------------------------------

// Même patron que StatutAbonnementPharmacie : abonnement de présence
// forfaitaire du médecin dans l'annuaire (seul produit publicitaire
// qui lui est ouvert — voir note du diagramme).
enum StatutAbonnementMedecin {
  actif
  expire
  annule
}

enum TypeRdv {
  physique
  teleconsultation
}

// Cycle de vie du rendez-vous, du dépôt initial jusqu'à l'issue de la
// consultation (honoré / non honoré) ou à une contestation par l'une
// des parties.
enum StatutRendezVous {
  cree
  confirme
  en_attente_presence
  honore
  non_honore
  annule
  conteste
  // Politique de fonds v2 §5 : les deux parties étaient absentes. Les
  // fonds restent en séquestre ; les deux parties ont 48h (à compter de
  // RendezVous.a_reprogrammer_le) pour convenir d'une nouvelle date,
  // faute de quoi le cron rembourse le patient (honoraires − frais
  // d'agrégateur − commission APS).
  a_reprogrammer
}

// Partie à l'origine d'une proposition de reprogrammation (§5) : l'autre
// partie est celle qui doit l'accepter.
enum PartieRendezVous {
  patient
  medecin
}

// Politique de fonds v2 §5 (étape 6, point ouvert E) — types de notification
// in-app. Liste fermée : un nouveau type = une valeur ajoutée ici + migration.
enum TypeNotification {
  // Les deux parties étaient absentes : elles ont 48h pour reprogrammer.
  rdv_a_reprogrammer
  // L'autre partie a proposé une nouvelle date : à accepter (ou à contre-proposer).
  rdv_reprogrammation_proposee
  // La partie qui avait proposé apprend que sa proposition est acceptée.
  rdv_reprogrammation_acceptee
  // Le paiement d'un RDV est confirmé (cree -> confirme) : le MÉDECIN est
  // notifié à ce moment-là seulement (D8) — jamais avant paiement, ni à la
  // création, ni à l'annulation ou l'expiration d'un RDV non payé.
  rdv_paye
  // Abonnements assurance (guide v3) : activation, rappels d'échéance
  // J-30 / J-7 / J-1. Destinataires : les agents de la fiche.
  abonnement_assurance_active
  abonnement_assurance_echeance
  // Abonnements de présence (pharmacies, centres de santé, médecins) :
  // activation et rappels d'échéance. Destinataires : les gestionnaires
  // de la fiche (agents, ou le médecin lui-même).
  abonnement_presence_active
  abonnement_presence_echeance
  // Agenda : le RDV demandé par le PATIENT n'a pas été confirmé (payé) dans
  // le délai du pays ; il est annulé et le créneau est libéré.
  rdv_confirmation_expiree
  // RDV PHYSIQUE payé : le médecin l'accepte en précisant le lieu ; le
  // PATIENT est notifié (date + lieu). Toujours après le paiement (D8).
  rdv_accepte
  // RDV aléatoire : nouvelle offre signalée aux MÉDECINS éligibles
  // (spécialité + pays + ville) ; nouvelle réponse signalée au PATIENT ;
  // offre expirée sans médecin validé (PATIENT).
  offre_rdv_nouvelle
  offre_rdv_reponse
  offre_rdv_expiree
  // Portail assurance : nouvelle demande de mise en relation reçue par une
  // fiche. Destinataires : les agents de la fiche.
  mise_en_relation_recue
  // Réputation médecin : invitation du PATIENT à noter une consultation
  // terminée ; avis publié (MÉDECIN) ; réponse du médecin (PATIENT).
  avis_medecin_invitation
  avis_medecin_publie
  avis_medecin_reponse
  // Rappels de RDV confirmé (MÉDECIN et PATIENT) : J-3, J-1, H-3 et à
  // l'heure du rendez-vous (palier dans `donnees.palier`).
  rdv_rappel
  // RDV aléatoire : le patient a retenu le MÉDECIN (candidature acceptée),
  // ou en a retenu un autre / laissé expirer la demande (non retenue).
  offre_rdv_candidature_retenue
  offre_rdv_candidature_non_retenue
}

// Motif d'annulation d'un rendez-vous — liste fermée exigée par la
// politique de gestion des fonds §3 ("toute annulation doit être
// motivée, motif en liste fermée, commentaire libre facultatif").
// Le commentaire libre vit dans RendezVous.commentaire_annulation.
enum MotifAnnulation {
  changement_horaire_patient
  urgence_personnelle
  erreur_reservation
  professionnel_indisponible
  autre
  // Agenda : annulation AUTOMATIQUE d'un RDV « cree » non confirmé
  // (non payé) dans le délai parametre_delai_confirmation. Jamais choisi
  // par un utilisateur (absent de la liste exposée par l'API).
  delai_confirmation_expire
}

// -----------------------------------------------------------------
// Enums — Agenda médecin
// -----------------------------------------------------------------

enum JourSemaine {
  lundi
  mardi
  mercredi
  jeudi
  vendredi
  samedi
  dimanche
}

// "bloque" est prévu pour une future gestion des indisponibilités
// ponctuelles (congé, urgence) même si ce n'est pas branché tout de
// suite : le créneau concret peut déjà porter ce statut sans
// changement de structure.
enum StatutCreneauAgenda {
  disponible
  reserve
  bloque
}

// Trace si un créneau concret vient de la génération automatique à
// partir du gabarit (DisponibiliteMedecin) ou d'une action manuelle
// du médecin pour cette semaine précise (ajout hors gabarit, ou
// modification d'un créneau généré). Sert notamment à permettre côté
// UI un bouton "réinitialiser cette semaine au gabarit" sans écraser
// les ajouts/retraits volontaires du médecin.
enum OrigineCreneauAgenda {
  genere
  manuel
}

// -----------------------------------------------------------------
// Référentiel géographique
// -----------------------------------------------------------------

model Langue {
  langue_id String @id @default(uuid()) @db.Uuid

  nom String @db.VarChar(50)

  pays Pays[]

  @@map("langue")
}

model Devise {
  devise_id String @id @default(uuid()) @db.Uuid

  libelle String @db.VarChar(50)

  pays Pays[]

  @@map("devise")
}

// v7 : "devise_reference" et "langue_defaut" (VARCHAR libres) sont
// remplacés par des FK vers des référentiels dédiés langue / devise,
// réutilisables et normalisés.
model Pays {
  pays_id String @id @default(uuid()) @db.Uuid

  code_iso2         String               @unique @db.Char(2)
  nom               String               @db.VarChar(100)
  devise_id         String               @db.Uuid
  langue_id         String               @db.Uuid
  statut_activation StatutActivationPays

  // Agenda : fuseau horaire IANA du pays (ex. "Africa/Douala"). Les
  // tranches d'Horaire et les dates de CreneauAgenda sont des heures
  // MURALES du médecin ; ce fuseau sert à les convertir en instant
  // (RendezVous.date_creneau) — voir src/lib/fuseauHoraire.js.
  fuseau_horaire String @default("Africa/Douala") @db.VarChar(64)

  devise Devise @relation(fields: [devise_id], references: [devise_id])
  langue Langue @relation(fields: [langue_id], references: [langue_id])

  villes            Ville[]
  utilisateurs      Utilisateur[]
  medecins_exercice Medecin[]
  structures_sante  StructureSante[]
  pharmacies        Pharmacie[]
  plannings_garde   PlanningGarde[]

  // v8 : Publicite (module autonome, plus PublicitePharmacie) — voir
  // plus bas.
  publicites             Publicite[]
  forfaits_publicitaires ForfaitPublicitaire[]

  // v8 : Annuaire assurances (diagramme 08_annuaire_assurances).
  services_assurance ServiceAssurance[]

  // Module Urgences (diagramme APS — Module : Urgences).
  urgences Urgence[]

  // Module transverse Gestion des médecins — pays d'émission d'une
  // ordonnance (peut différer du pays d'exercice du médecin en
  // téléconsultation transfrontalière).
  ordonnances_emises Ordonnance[]

  // Module transverse : Moyens de paiement du médecin
  types_mobile_money TypeMobileMoney[]

  // Module transverse : Paiements & escrow — lignes tarifaires
  // versionnées (commission APS, taxes, frais d'agrégateur) en vigueur
  // par pays. Voir LigneTarifaire plus bas.
  lignes_tarifaires LigneTarifaire[]

  // Politique de fonds v2 §7 : taux d'amende du médecin, versionné par
  // pays (voir ParametreAmende plus bas).
  parametres_amende ParametreAmende[]

  // Libération différée des fonds : délai T (heures) par pays, versionné
  // (voir ParametreDelaiLiberation plus bas).
  parametres_delai_liberation ParametreDelaiLiberation[]

  // Agenda : délai (heures) pendant lequel un RDV « cree » (non payé)
  // bloque son créneau avant annulation automatique, par pays, versionné
  // (voir ParametreDelaiConfirmation plus bas).
  parametres_delai_confirmation ParametreDelaiConfirmation[]

  // Abonnements assurance : grille tarifaire et configuration (gratuité
  // d'amorçage, durée de grâce) par pays.
  tarifs_abonnement_assurance TarifAbonnementAssurance[]
  config_abonnement_assurance ConfigAbonnementAssurance?

  // Abonnements de présence (pharmacies, centres de santé, médecins) :
  // grille tarifaire et configuration par type d'acteur et par pays.
  tarifs_abonnement_presence  TarifAbonnementPresence[]
  configs_abonnement_presence ConfigAbonnementPresence[]
  // RDV aléatoire : offres publiées dans ce pays.
  offres_rdv                  OffreRdv[]

  @@index([devise_id])
  @@index([langue_id])
  @@map("pays")
}

// v6 : remplace "division_administrative" (region/departement/commune/
// ville/quartier + FK réflexive). Un seul niveau administratif sous
// le pays : la ville.
model Ville {
  ville_id String @id @default(uuid()) @db.Uuid

  pays_id     String  @db.Uuid
  nom         String  @db.VarChar(150)
  code_postal String? @db.VarChar(20)

  pays Pays @relation(fields: [pays_id], references: [pays_id])

  medecins_exercice Medecin[]
  structures_sante  StructureSante[]
  pharmacies        Pharmacie[]
  gardes_pharmacie  GardePharmacie[]

  // v8 : Annuaire assurances (diagramme 08_annuaire_assurances).
  services_assurance ServiceAssurance[]
  // RDV aléatoire : offres publiées dans cette ville.
  offres_rdv         OffreRdv[]

  @@index([pays_id])
  @@map("ville")
}

// -----------------------------------------------------------------
// IAM — Identité & authentification
// -----------------------------------------------------------------

// Remplace l'ancien enum RoleUtilisateur : le rôle devient une donnée
// (table de référence) plutôt qu'une valeur figée dans le schéma.
// Permet d'ajouter/renommer un rôle sans migration de type enum.
model Role {
  role_id String @id @default(uuid()) @db.Uuid

  libelle     String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  utilisateurs Utilisateur[]

  @@map("role")
}

// v6 : la valeur de rôle "agent_service" devient "agent" (générique).
// Le type précis d'agent (structure de santé, pharmacie, ambulance,
// pompes funèbres, assurance) se déduit de la table agent_xxx dans
// laquelle une ligne existe pour cet utilisateur_id — voir plus bas.
// v7 : "nom" et "prenom" remontent au niveau utilisateur (identité
// unique). Ils sont retirés de patient et medecin, qui n'ont plus à
// les dupliquer.
model Utilisateur {
  utilisateur_id String @id @default(uuid()) @db.Uuid

  nom               String       @db.VarChar(100)
  prenom            String       @db.VarChar(100)
  email             String       @unique @db.VarChar(255)
  telephone         String?      @db.VarChar(20)
  mot_de_passe_hash String       @db.VarChar(255)
  role_id           String       @db.Uuid
  pays_id           String       @db.Uuid
  statut_compte     StatutCompte

  // Comptes créés POUR un tiers (ex. agent d'un centre de santé créé
  // en même temps que la fiche structure_sante, avec un mot de passe
  // généré côté serveur — voir centreSante.controller.js) : le
  // titulaire doit changer ce mot de passe temporaire dès sa première
  // connexion.
  //   - mot_de_passe_temporaire : true tant que le mot de passe généré
  //     n'a pas été remplacé par le titulaire.
  //   - mot_de_passe_expire_le  : à poser par le contrôleur de login
  //     (non fourni ici) lors de la toute première connexion — deadline
  //     "maintenant + 24h" avant laquelle le changement est obligatoire.
  //     Reste `null` tant qu'aucune première connexion n'a eu lieu.
  mot_de_passe_temporaire Boolean   @default(false)
  mot_de_passe_expire_le  DateTime?

  // ── Connexion numéro + code PIN (parcours B, révision 3 de la
  // conception « sécurisation de la connexion ») ──
  // Numéro de connexion normalisé (international sans « + »). Distinct
  // de `telephone` (saisie libre historique, ni unique ni normalisée).
  telephone_connexion String?   @unique @db.VarChar(20)
  // Vrai seulement après un code reçu par WhatsApp/SMS (aucun canal
  // ouvert pour l'instant : les numéros restent « non vérifiés »).
  telephone_verifie   Boolean   @default(false)
  // PIN à 6 chiffres, haché comme un mot de passe.
  pin_hash            String?   @db.VarChar(255)
  // PIN donné par un administrateur : à changer à la première connexion.
  pin_provisoire      Boolean   @default(false)
  // Limite d'essais PAR COMPTE : 5 erreurs -> blocage, durée doublée à
  // chaque blocage successif (remise à zéro après une connexion réussie).
  pin_echecs          Int       @default(0)
  pin_bloque_jusqu_au DateTime?
  pin_nb_blocages     Int       @default(0)
  // Dernier espace ouvert (« patient », « medecin », « pharmacie:<id> »…).
  dernier_espace      String?   @db.VarChar(80)

  role Role @relation(fields: [role_id], references: [role_id])
  pays Pays @relation(fields: [pays_id], references: [pays_id])

  // Étape 6 : notifications in-app reçues.
  notifications          Notification[]
  appareils_push         AppareilPush[]
  // Messages WhatsApp qui lui ont été adressés (journal d'envoi).
  messages_whatsapp      MessageWhatsapp[]
  // SMS qui lui ont été adressés (journal d'envoi, Twilio).
  messages_sms           MessageSms[]
  // Connexions web à valider depuis l'application mobile.
  demandes_connexion_web DemandeConnexionWeb[]

  medecin                Medecin?
  patient                Patient?
  refresh_tokens         RefreshToken[]
  jetons_revoques        JetonRevoque[]
  // Rattachements d'agent : plusieurs fiches possibles par compte (espaces).
  agents_structure_sante AgentStructureSante[]
  agents_pompes_funebres AgentPompesFunebres[]
  agents_assurance       AgentAssurance[]
  agents_pharmacie       AgentPharmacie[]
  agents_ambulance       AgentAmbulance[]
  avis_pharmacie         AvisPharmacie[]

  // Module transverse Gestion des médecins — voir plus bas dans ce fichier.
  avis_medecin AvisMedecin[]

  // v8 : module autonome "Présence, publicité & boost commercial" —
  // une publicité est déposée directement par un utilisateur, quel
  // que soit son rôle, sans passer par un profil agent_xxx.
  publicites Publicite[]

  // v8 : Annuaire assurances — remplace l'ancien
  // "contact_prospect_assurance" (patient -> assurance, 1-N) par cette
  // relation N-N utilisateur <-> assurance (n'importe quel utilisateur
  // peut contacter 1-N assurances, une assurance peut être contactée
  // par 1-N utilisateurs) — voir table de jointure MiseEnRelation.
  mises_en_relation MiseEnRelation[]

  @@index([pays_id])
  @@index([role_id])
  @@map("utilisateur")
}

// Référentiel des spécialités médicales (ex : cardiologie, pédiatrie,
// dermatologie...). Auparavant portée par un simple VARCHAR libre sur
// Medecin.specialite — corrigé ici en une véritable entité, réutilisable
// et normalisée, à laquelle un médecin est rattaché par FK (même patron
// que Langue/Devise réutilisés par Pays plus haut dans ce fichier).
model Specialite {
  specialite_id String @id @default(uuid()) @db.Uuid

  nom         String  @unique @db.VarChar(150)
  description String? @db.Text

  medecins   Medecin[]
  // RDV aléatoire : offres visant cette spécialité.
  offres_rdv OffreRdv[]

  @@map("specialite")
}

model Medecin {
  medecin_id String @id @default(uuid()) @db.Uuid

  utilisateur_id            String                    @unique @db.Uuid
  specialite_id             String                    @db.Uuid
  numero_ordre              String                    @db.VarChar(100)
  statut_verification       StatutVerificationMedecin
  // Première mise en ligne (posée par déclencheur SQL, jamais effacée).
  // Une fiche déjà publiée qui repasse « en_cours » après une
  // modification garde ses droits d'abonnement pendant la modération.
  date_premiere_publication DateTime?
  pays_exercice_id          String                    @db.Uuid
  ville_exercice_id         String                    @db.Uuid
  teleconsultation_activee  Boolean
  tarif_indicatif           Decimal                   @db.Decimal(12, 2)

  // Position du lieu d'exercice (facultative) — même patron que
  // Pharmacie / StructureSante : GEOGRAPHY(POINT,4326) PostGIS non
  // supporté nativement par Prisma Client (Unsupported(...)), donc
  // lecture/écriture via $queryRaw / $executeRaw par lib/geo.js
  // (voir medecin.controller.js). NULL tant que le médecin n'a pas
  // renseigné sa position. Index GIST créé par migration SQL manuelle
  // (20261002100000_medecin_geolocalisation).
  geolocalisation Unsupported("geography(Point, 4326)")?

  biographie  String  @default("") @db.Text
  linkedInUrl String? @db.VarChar(255)

  // Pièces justificatives (Cloudinary) — voir lib/cloudinaryService.js.
  // Seul le "nom" (public_id Cloudinary, avec extension) est stocké,
  // jamais l'URL complète — même règle que StructureSante.image_nom /
  // piece_identite_nom / document_agrement_nom plus bas dans ce fichier.
  // Les deux sont requises à la création du médecin (admin/superadmin,
  // via POST /comptes — voir authentification.controller.js,
  // creerCompteAdministre) :
  //   - cni_url         : carte nationale d'identité du médecin
  //   - attestation_url : attestation d'inscription à l'Ordre
  cni_url         String  @db.VarChar(255)
  attestation_url String  @db.VarChar(255)
  cv_url          String? @db.VarChar(255)

  // Photo de profil du médecin (Cloudinary) — même règle de stockage
  // que cni_url / attestation_url ci-dessus.
  photo_url String? @db.VarChar(255)

  // Réputation : moyenne des notes globales des avis PUBLIÉS et leur
  // nombre, recalculées à chaque modération / suppression (voir
  // recalculerNoteMedecin, services/avisMedecin.service.js). Dénormalisées
  // pour l'annuaire (cartes, tri) ; NULL / 0 tant qu'aucun avis publié.
  note_moyenne Decimal? @db.Decimal(3, 2)
  nombre_avis  Int      @default(0)

  date_creation DateTime @default(now())

  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])
  specialite     Specialite  @relation(fields: [specialite_id], references: [specialite_id])
  pays_exercice  Pays        @relation(fields: [pays_exercice_id], references: [pays_id])
  ville_exercice Ville       @relation(fields: [ville_exercice_id], references: [ville_id])

  // Module transverse Gestion des médecins (diagramme APS — Module
  // transverse : Gestion des médecins) — voir plus bas dans ce fichier.
  avis AvisMedecin[]

  // v9 : un médecin peut souscrire à plusieurs abonnements (successifs
  // ou simultanés) — relation N-N portée par la table de jointure
  // ForfaitAbonnementMedecin, voir plus bas dans ce fichier.
  forfaits_abonnement ForfaitAbonnementMedecin[]
  rendez_vous         RendezVous[]
  ordonnances         Ordonnance[]

  // Module transverse : Moyens de paiement du médecin
  mobile_moneys     MobileMoney[]
  comptes_bancaires CompteBancaire[]
  compte_stripe     CompteStripeConnect?

  // Module transverse : Agenda du médecin — voir plus bas dans ce
  // fichier. disponibilites porte le gabarit récurrent (jour de la
  // semaine + horaire), creneaux_agenda porte les instances
  // concrètes par date réelle, générées à partir du gabarit.
  disponibilites  DisponibiliteMedecin[]
  creneaux_agenda CreneauAgenda[]

  // Module transverse : Paiements — Phase 1 (portefeuille & grand-livre).
  // Un seul portefeuille par médecin, créé à l'inscription (ou par la
  // migration de rattrapage pour les médecins déjà existants) — voir
  // schema plus bas (PortefeuilleMedecin) et services/portefeuille.service.js.
  portefeuille PortefeuilleMedecin?

  // Politique de fonds v2 §7 : amendes dues par ce médecin (une par RDV
  // fautif), imputées sur sa prochaine libération de fonds.
  amendes AmendeMedecin[]

  // Phase 6 : demandes de retrait (décaissement Mobile Money via CamPay).
  demandes_retrait DemandeRetrait[]

  // Abonnements de présence (voir AbonnementPresence en fin de fichier).
  abonnements_presence AbonnementPresence[]
  // RDV aléatoire : réponses de ce médecin aux offres des patients.
  reponses_offre_rdv   ReponseOffreRdv[]
  // Tableau de bord : interactions des visiteurs avec la fiche publique.
  engagements          EngagementMedecin[]

  @@index([specialite_id])
  @@index([pays_exercice_id])
  @@index([ville_exercice_id])
  @@map("medecin")
}

model Patient {
  patient_id String @id @default(uuid()) @db.Uuid

  utilisateur_id String   @unique @db.Uuid
  date_naissance DateTime @db.Date

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])

  // Module transverse Gestion des médecins — voir plus bas dans ce fichier.
  rendez_vous RendezVous[]
  ordonnances Ordonnance[]
  // RDV aléatoire : offres publiées par ce patient.
  offres_rdv  OffreRdv[]

  @@map("patient")
}

// Le refresh token est stocké côté serveur (sous forme de hash, jamais
// en clair) afin de pouvoir être invalidé (logout, rotation,
// compromission). L'access token JWT, lui, reste stateless et n'est
// pas persisté : il n'est vérifié qu'à l'aide de sa signature et de
// sa date d'expiration (claim "exp").
model RefreshToken {
  refresh_token_id String @id @default(uuid()) @db.Uuid

  utilisateur_id  String             @db.Uuid
  token_hash      String             @unique @db.VarChar(255)
  date_creation   DateTime           @default(now())
  date_expiration DateTime
  date_revocation DateTime?
  user_agent      String?            @db.VarChar(255)
  ip_creation     String?            @db.VarChar(45)
  statut          StatutRefreshToken
  // Espace actif de la session (« patient », « pharmacie:<id> »…),
  // repris à chaque renouvellement du jeton d'accès.
  espace          String?            @db.VarChar(80)

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])

  @@index([utilisateur_id])
  @@map("refresh_token")
}

// Liste de révocation ("denylist") des access tokens JWT non encore
// expirés. Chaque JWT émis porte un identifiant unique (claim "jti").
// Une entrée ici avant "date_expiration_initiale" invalide le token
// malgré une signature valide (ex : déconnexion forcée, changement de
// mot de passe). Les lignes peuvent être purgées une fois
// "date_expiration_initiale" dépassée.
model JetonRevoque {
  jti String @id @default(uuid()) @db.Uuid

  utilisateur_id           String          @db.Uuid
  date_revocation          DateTime        @default(now())
  date_expiration_initiale DateTime
  motif                    MotifRevocation

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])

  @@index([utilisateur_id])
  @@map("jeton_revoque")
}

// -----------------------------------------------------------------
// Agents — profils métier rattachés à un utilisateur de rôle "agent"
//
// Limite structurelle acceptée (v6) : la contrainte UK sur
// utilisateur_id est posée table par table. Elle garantit qu'un
// utilisateur a au plus 1 ligne d'agent PAR type de service, mais ne
// peut pas empêcher nativement qu'un même utilisateur soit agent dans
// deux tables différentes (ex : agent_pharmacie ET agent_ambulance).
// À défaut de supertype "service", ce contrôle transverse devra être
// fait en application (ou via un trigger/contrainte applicative
// dédiée).
// -----------------------------------------------------------------

model AgentStructureSante {
  agent_id String @id @default(uuid()) @db.Uuid

  utilisateur_id String @db.Uuid
  structure_id   String @db.Uuid
  fonction       String @db.VarChar(100)

  utilisateur Utilisateur    @relation(fields: [utilisateur_id], references: [utilisateur_id])
  structure   StructureSante @relation(fields: [structure_id], references: [structure_id])

  // Option A (espaces multiples) : un compte peut gérer plusieurs fiches,
  // une seule ligne par couple compte / fiche.
  @@unique([utilisateur_id, structure_id])
  @@index([structure_id])
  @@index([utilisateur_id])
  @@map("agent_structure_sante")
}

model AgentPompesFunebres {
  agent_id String @id @default(uuid()) @db.Uuid

  utilisateur_id     String @db.Uuid
  pompes_funebres_id String @db.Uuid
  fonction           String @db.VarChar(100)

  utilisateur     Utilisateur    @relation(fields: [utilisateur_id], references: [utilisateur_id])
  pompes_funebres PompesFunebres @relation(fields: [pompes_funebres_id], references: [pompes_funebres_id])

  // Option A (espaces multiples) : un compte peut gérer plusieurs fiches,
  // une seule ligne par couple compte / fiche.
  @@unique([utilisateur_id, pompes_funebres_id])
  @@index([pompes_funebres_id])
  @@index([utilisateur_id])
  @@map("agent_pompes_funebres")
}

model AgentAssurance {
  agent_id String @id @default(uuid()) @db.Uuid

  utilisateur_id       String @db.Uuid
  service_assurance_id String @db.Uuid
  fonction             String @db.VarChar(100)

  utilisateur       Utilisateur      @relation(fields: [utilisateur_id], references: [utilisateur_id])
  service_assurance ServiceAssurance @relation(fields: [service_assurance_id], references: [service_assurance_id])

  // Option A (espaces multiples) : un compte peut gérer plusieurs fiches,
  // une seule ligne par couple compte / fiche.
  @@unique([utilisateur_id, service_assurance_id])
  @@index([service_assurance_id])
  @@index([utilisateur_id])
  @@map("agent_assurance")
}

model AgentPharmacie {
  agent_id String @id @default(uuid()) @db.Uuid

  utilisateur_id String @db.Uuid
  pharmacie_id   String @db.Uuid
  fonction       String @db.VarChar(100)

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])
  pharmacie   Pharmacie   @relation(fields: [pharmacie_id], references: [pharmacie_id])

  // Option A (espaces multiples) : un compte peut gérer plusieurs fiches,
  // une seule ligne par couple compte / fiche.
  @@unique([utilisateur_id, pharmacie_id])
  @@index([pharmacie_id])
  @@index([utilisateur_id])
  @@map("agent_pharmacie")
}

model AgentAmbulance {
  agent_id String @id @default(uuid()) @db.Uuid

  utilisateur_id       String @db.Uuid
  service_ambulance_id String @db.Uuid
  fonction             String @db.VarChar(100)

  utilisateur       Utilisateur      @relation(fields: [utilisateur_id], references: [utilisateur_id])
  service_ambulance ServiceAmbulance @relation(fields: [service_ambulance_id], references: [service_ambulance_id])

  // Option A (espaces multiples) : un compte peut gérer plusieurs fiches,
  // une seule ligne par couple compte / fiche.
  @@unique([utilisateur_id, service_ambulance_id])
  @@index([service_ambulance_id])
  @@index([utilisateur_id])
  @@map("agent_ambulance")
}

// -----------------------------------------------------------------
// «ref» — Tables détenues par d'autres modules du diagramme APS.
// Elles sont déclarées ici en stub (PK seule) uniquement pour que les
// FK des tables agent_xxx ci-dessus soient valides et que ce schéma
// compile isolément. Leurs définitions complètes (colonnes, index,
// relations propres) vivent dans les fichiers de module dédiés et
// devront être fusionnées / remplacées lors de l'intégration :
//   - structure_sante   → diagramme 02_annuaire_recherche
//   - pompes_funebres   → diagramme 07_services_connexes
//   - pharmacie         → diagramme 03_pharmacie_gardes
//   - service_ambulance → diagramme 07_services_connexes
// v8 : service_assurance n'est plus un stub — voir plus bas le module
// complet "Annuaire assurances" (diagramme 08_annuaire_assurances).
// -----------------------------------------------------------------

// -----------------------------------------------------------------
// Annuaire — structure_sante (diagramme 02_annuaire_recherche)
//
// "geolocalisation" est un GEOGRAPHY(POINT,4326) PostGIS. Prisma
// Client ne sait pas lire/écrire ce type nativement (introspection en
// Unsupported(...)) : le contrôleur passe par $queryRaw / $executeRaw
// pour cette seule colonne, le reste des opérations utilise le client
// Prisma standard.
// -----------------------------------------------------------------
model StructureSante {
  structure_id String @id @default(uuid()) @db.Uuid

  nom                       String                                 @db.VarChar(200)
  pays_id                   String                                 @db.Uuid
  ville_id                  String                                 @db.Uuid
  geolocalisation           Unsupported("geography(Point, 4326)")?
  telephone                 String                                 @db.VarChar(20)
  statut_verification       StatutVerificationStructure
  // Première mise en ligne (posée par déclencheur SQL, jamais effacée).
  // Une fiche déjà publiée qui repasse « en_cours » après une
  // modification garde ses droits d'abonnement pendant la modération.
  date_premiere_publication DateTime?
  type_structure            TypeStructure

  // Pièces justificatives (Cloudinary) — voir lib/cloudinaryService.js.
  // Seul le "nom" (public_id Cloudinary) est stocké ; l'URL publique
  // est reconstruite à la volée, jamais persistée. Requises à la
  // création (3 fichiers obligatoires — voir centreSante.controller.js) :
  //   - image_nom             : photo du centre de santé
  //   - piece_identite_nom    : pièce d'identité du professionnel
  //   - document_agrement_nom : agrément officiel d'exercice
  image_nom             String @db.VarChar(255)
  piece_identite_nom    String @db.VarChar(255)
  document_agrement_nom String @db.VarChar(255)

  // Contenus enrichis (abonnement de présence) : toujours conservés en
  // base, exposés au public seulement si l'abonnement actif le permet
  // (voir lib/droitsPresence.js).
  description_enrichie String? @db.Text
  presentation_equipe  String? @db.Text

  pays  Pays  @relation(fields: [pays_id], references: [pays_id])
  ville Ville @relation(fields: [ville_id], references: [ville_id])

  agents AgentStructureSante[]

  abonnements_presence AbonnementPresence[]

  // Module transverse Gestion des médecins — un rendez-vous "physique"
  // peut être rattaché à une structure de santé (nullable : cabinet
  // libéral du médecin sinon) — voir plus bas dans ce fichier.
  rendez_vous RendezVous[]

  @@index([pays_id])
  @@index([ville_id])
  @@map("structure_sante")
}

/// @ref module 07_services_connexes — définition complète à fusionner
model PompesFunebres {
  pompes_funebres_id String @id @default(uuid()) @db.Uuid

  agents AgentPompesFunebres[]

  @@map("pompes_funebres")
}

// -----------------------------------------------------------------
// Annuaire assurances (diagramme 08_annuaire_assurances, v8)
//
// Module secondaire qui enrichit la plateforme sans entrer dans le
// parcours critique de soin/urgence.
//
// service_assurance est le supertype de la fiche annuaire (compagnie
// ou courtier, cf. type_acteur) — même patron que structure_sante /
// pharmacie plus haut : "geolocalisation" est un GEOGRAPHY(POINT,4326)
// PostGIS non supporté nativement par Prisma Client (Unsupported(...)),
// lecture/écriture passent par $queryRaw / $executeRaw.
//
// v8 : ajout du catalogue activite / option_activite (une assurance
// possède N activités ; chaque activité porte ses propres options,
// comme sur la maquette), ajout de agence (une assurance possède N
// agences), et ajout des champs email / agrement / description sur la
// fiche elle-même. remplacement de contact_prospect_assurance
// (patient -> assurance, 1-N) par mise_en_relation (utilisateur <->
// assurance, N-N) — voir Utilisateur plus haut.
// -----------------------------------------------------------------
model ServiceAssurance {
  service_assurance_id String @id @default(uuid()) @db.Uuid

  nom                 String                                 @db.VarChar(200)
  pays_id             String                                 @db.Uuid
  ville_id            String                                 @db.Uuid
  geolocalisation     Unsupported("geography(Point, 4326)")?
  telephone           String                                 @db.VarChar(20)
  // Pièce justificative (Cloudinary) — voir lib/cloudinaryService.js.
  // Seul le "nom" (public_id Cloudinary) est stocké ; l'URL publique
  // est reconstruite à la volée, jamais persistée.
  file_url            String                                 @db.Text
  email               String                                 @db.VarChar(255)
  // Numéro ou texte d'agrément réglementaire de la compagnie/du
  // courtier.
  agrement            String                                 @db.VarChar(100)
  // Présentation libre de l'assurance, cf. onglet "Siège" de la
  // maquette.
  description         String?                                @db.Text
  statut_verification StatutVerificationAssurance
  type_acteur         TypeActeurAssurance

  pays  Pays  @relation(fields: [pays_id], references: [pays_id])
  ville Ville @relation(fields: [ville_id], references: [ville_id])

  agents            AgentAssurance[]
  mises_en_relation MiseEnRelation[]
  activites         Activite[]
  agences           Agence[]
  medias            MediaAssurance[]

  // Abonnements de présence (niveaux Enrichie / Premium, etc.). Voir
  // AbonnementAssurance plus bas.
  abonnements AbonnementAssurance[]

  @@index([pays_id])
  @@index([ville_id])
  @@map("service_assurance")
}

// Table de jointure N-N utilisateur <-> assurance. Remplace l'ancien
// "contact_prospect_assurance" (qui référençait patient) : c'est
// désormais un utilisateur quelconque qui contacte une assurance —
// voir Utilisateur.mises_en_relation plus haut.
//
// Portail assurance : l'agent suit chaque demande (statut + note interne,
// jamais montrée au demandeur). Le suivi exige le droit `suivi_demandes`
// de l'abonnement ; la lecture des demandes reçues reste toujours ouverte
// à l'agent.
enum StatutMiseEnRelation {
  nouvelle // pas encore ouverte par l'agent
  en_cours // prise en charge (contact établi, devis en préparation…)
  traitee // clôturée
  archivee // classée sans suite
}

model MiseEnRelation {
  mise_en_relation_id String @id @default(uuid()) @db.Uuid

  service_assurance_id String               @db.Uuid
  utilisateur_id       String               @db.Uuid
  message              String               @db.Text
  statut               StatutMiseEnRelation @default(nouvelle)
  note_interne         String?              @db.Text
  date_traitement      DateTime? // passage à « traitee » ou « archivee »
  date_creation        DateTime             @default(now())
  date_mise_a_jour     DateTime?            @updatedAt

  service_assurance ServiceAssurance @relation(fields: [service_assurance_id], references: [service_assurance_id])
  utilisateur       Utilisateur      @relation(fields: [utilisateur_id], references: [utilisateur_id])

  @@index([service_assurance_id, statut])
  @@index([utilisateur_id])
  @@map("mise_en_relation")
}

// Médiathèque d'une fiche assurance (portail assurance) : photos et vidéos
// téléversées sur Cloudinary. Comme partout, seul le « nom » Cloudinary est
// stocké ; `type` donne le resource_type (image | video) nécessaire pour
// reconstruire l'URL et supprimer le fichier. Visibilité publique selon les
// droits de l'abonnement : `max_photos` (null = illimité) et
// `video_presentation`. Les médias au-delà des droits sont CONSERVÉS
// (masqués au public) et réapparaissent à la réactivation.
enum TypeMediaAssurance {
  image
  video
}

model MediaAssurance {
  media_id String @id @default(uuid()) @db.Uuid

  service_assurance_id String             @db.Uuid
  type                 TypeMediaAssurance
  fichier_nom          String             @db.Text
  titre                String?            @db.VarChar(150)
  ordre                Int                @default(0)
  taille_octets        Int?
  date_creation        DateTime           @default(now())

  service_assurance ServiceAssurance @relation(fields: [service_assurance_id], references: [service_assurance_id])

  @@index([service_assurance_id, type, ordre])
  @@map("media_assurance")
}

// Catalogue des activités (produits) d'une assurance — ex. "Activa
// Santé Individuelle" / public_cible "Particuliers et familles". Une
// assurance possède N activités ; une activité appartient à une seule
// assurance.
model Activite {
  activite_id String @id @default(uuid()) @db.Uuid

  service_assurance_id String  @db.Uuid
  titre                String  @db.VarChar(200)
  public_cible         String  @db.VarChar(200)
  description          String? @db.Text

  service_assurance ServiceAssurance @relation(fields: [service_assurance_id], references: [service_assurance_id])

  options OptionActivite[]

  @@index([service_assurance_id])
  @@map("activite")
}

// Options rattachées à une activité (et non directement à l'assurance)
// — ex. "Hospitalisation", "Consultations & pharmacie", "Maternité" :
// chaque produit porte ses propres options, comme sur la maquette.
model OptionActivite {
  option_activite_id String @id @default(uuid()) @db.Uuid

  activite_id String  @db.Uuid
  libelle     String  @db.VarChar(150)
  description String? @db.Text

  activite Activite @relation(fields: [activite_id], references: [activite_id])

  @@index([activite_id])
  @@map("option_activite")
}

// Agences physiques d'une assurance — ex. "Agence Douala — Akwa
// (Siège)". Une assurance possède N agences ; une agence appartient à
// une seule assurance.
model Agence {
  agence_id String @id @default(uuid()) @db.Uuid

  service_assurance_id String                                 @db.Uuid
  libelle              String                                 @db.VarChar(150)
  localisation         String                                 @db.VarChar(255)
  gps                  Unsupported("geography(Point, 4326)")?
  contact              String                                 @db.VarChar(20)

  service_assurance ServiceAssurance @relation(fields: [service_assurance_id], references: [service_assurance_id])

  @@index([service_assurance_id])
  @@map("agence")
}

// -----------------------------------------------------------------
// Pharmacie (diagramme 03_pharmacie_gardes)
//
// Même patron que structure_sante : "geolocalisation" est un
// GEOGRAPHY(POINT,4326) PostGIS non supporté nativement par Prisma
// Client (Unsupported(...)) — lecture/écriture passent par
// $queryRaw / $executeRaw (voir pharmacie.controller.js).
//
// planning_garde / garde_pharmacie (système de garde) ne sont pas
// modélisés ici : ce sont des tables distinctes qui référencent
// pharmacie_id une fois cette fiche existante (voir diagramme
// 03_pharmacie_gardes) — hors périmètre du composant CRUD de base.
// -----------------------------------------------------------------
model Pharmacie {
  pharmacie_id String @id @default(uuid()) @db.Uuid

  nom                       String                                 @db.VarChar(200)
  pays_id                   String                                 @db.Uuid
  ville_id                  String                                 @db.Uuid
  geolocalisation           Unsupported("geography(Point, 4326)")?
  telephone                 String                                 @db.VarChar(20)
  statut_verification       StatutVerificationPharmacie
  // Première mise en ligne (posée par déclencheur SQL, jamais effacée).
  // Une fiche déjà publiée qui repasse « en_cours » après une
  // modification garde ses droits d'abonnement pendant la modération.
  date_premiere_publication DateTime?
  // Numéro d'ordre du titulaire (pharmacien responsable) — atteste
  // qu'il est habilité par l'ordre des pharmaciens à exercer.
  numero_ordre_titulaire    String                                 @db.VarChar(100)

  // Pièces justificatives (Cloudinary) — voir lib/cloudinaryService.js.
  // Seul le "nom" (public_id Cloudinary) est stocké ; l'URL publique
  // est reconstruite à la volée, jamais persistée. Requises à la
  // création (3 fichiers obligatoires — voir pharmacie.controller.js) :
  //   - image_nom             : photo de la pharmacie
  //   - piece_identite_nom    : pièce d'identité du titulaire/responsable
  //   - document_agrement_nom : agrément officiel d'exercice
  image_nom             String @db.VarChar(255)
  piece_identite_nom    String @db.VarChar(255)
  document_agrement_nom String @db.VarChar(255)

  // Contenus enrichis (abonnement de présence) : toujours conservés en
  // base, exposés au public seulement si l'abonnement actif le permet
  // (EF-PHA-07, voir lib/droitsPresence.js).
  description_enrichie  String? @db.Text
  services_particuliers String? @db.Text

  pays  Pays  @relation(fields: [pays_id], references: [pays_id])
  ville Ville @relation(fields: [ville_id], references: [ville_id])

  agents      AgentPharmacie[]
  avis        AvisPharmacie[]
  abonnements AbonnementPharmacie[]
  gardes      GardePharmacie[]

  abonnements_presence AbonnementPresence[]

  @@index([pays_id])
  @@index([ville_id])
  @@map("pharmacie")
}

// -----------------------------------------------------------------
// Pharmacie — Avis (diagramme 03_pharmacie_gardes)
//
// Modération manuelle : un avis nouvellement déposé est toujours
// "en_attente" et n'est visible publiquement qu'une fois "publie" par
// un admin/superadmin (voir avisPharmacie.controller.js). La note est
// bornée 1-5 en application (pas de CHECK en base — même choix que le
// reste du schéma).
//
// Limite structurelle acceptée : rien n'empêche nativement un même
// utilisateur de déposer plusieurs avis sur la même pharmacie (pas de
// contrainte unique [utilisateur_id, pharmacie_id]) — à arbitrer côté
// produit si "un seul avis par utilisateur" devient une règle requise.
// -----------------------------------------------------------------
model AvisPharmacie {
  avis_id String @id @default(uuid()) @db.Uuid

  utilisateur_id    String               @db.Uuid
  pharmacie_id      String               @db.Uuid
  note              Int                  @db.SmallInt
  commentaire       String?              @db.Text
  statut_moderation StatutModerationAvis @default(en_attente)
  date_creation     DateTime             @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])
  pharmacie   Pharmacie   @relation(fields: [pharmacie_id], references: [pharmacie_id])

  @@index([utilisateur_id])
  @@index([pharmacie_id])
  @@map("avis_pharmacie")
}

// -----------------------------------------------------------------
// Pharmacie — Abonnement (diagramme 03_pharmacie_gardes)
//
// Un abonnement est toujours adossé à une transaction_paiement déjà
// réglée (module 06_paiement_escrow, table «ref» stubée plus bas) :
// le contrôleur ne crée jamais un abonnement sans transaction_id
// valide. ligne_abonnement_pharmacie détaille les avantages inclus
// (contenu éditorial, affiché tel quel côté front).
// -----------------------------------------------------------------
model AbonnementPharmacie {
  abonnement_id String @id @default(uuid()) @db.Uuid

  pharmacie_id   String                    @db.Uuid
  libelle        String                    @db.VarChar(100)
  montant        Decimal                   @db.Decimal(12, 2)
  duree_jours    Int
  date_debut     DateTime                  @db.Date
  date_fin       DateTime                  @db.Date
  transaction_id String                    @db.Uuid
  statut         StatutAbonnementPharmacie

  pharmacie   Pharmacie           @relation(fields: [pharmacie_id], references: [pharmacie_id])
  transaction TransactionPaiement @relation(fields: [transaction_id], references: [transaction_id])

  lignes LigneAbonnementPharmacie[]

  @@index([pharmacie_id])
  @@index([transaction_id])
  @@map("abonnement_pharmacie")
}

model LigneAbonnementPharmacie {
  ligne_id String @id @default(uuid()) @db.Uuid

  abonnement_id    String  @db.Uuid
  libelle_avantage String  @db.VarChar(150)
  description      String? @db.Text
  ordre_affichage  Int     @db.SmallInt

  abonnement AbonnementPharmacie @relation(fields: [abonnement_id], references: [abonnement_id])

  @@index([abonnement_id])
  @@map("ligne_abonnement_pharmacie")
}

// -----------------------------------------------------------------
// Présence, publicité & boost commercial (diagramme
// 09_presence_publicite_boost) — MODULE AUTONOME.
//
// v8 : ce module a été isolé de Pharmacie. Il ne référence plus
// aucune fiche annuaire (pharmacie, structure_sante, ...) : une
// publicité est portée directement par l'utilisateur qui la dépose et
// le pays où elle est diffusée. Seules deux tables «ref» externes
// restent utilisées, communes à toute la plateforme : Utilisateur et
// Pays (voir plus haut). PageWebsite et PublicitePharmacie
// (précédemment détenues par le module Pharmacie) sont retirées : le
// module Pharmacie n'a donc plus AUCUN lien, fonctionnel ou de
// données, avec la publicité — voir pharmacie.controller.js.
//
// emplacement_publicitaire décrit le TYPE d'espace publicitaire du
// site (ex. "accueil", "résultats de recherche", "fiche pharmacie"...)
// — table de référence pure (mêmes patron que Langue/Devise/Pays/Ville,
// voir plus haut), pas un enum : les zones possibles sont des LIGNES de
// cette table (via code/libelle), pas des valeurs figées dans le
// schéma. forfait_publicitaire packages un emplacement avec une
// durée/un prix ; publicite est l'encart effectivement soumis par un
// utilisateur pour diffusion et référence désormais DIRECTEMENT
// l'emplacement choisi (emplacement_publicitaire_id), en plus du
// forfait_publicitaire_id qui en fixe le prix/la durée.
// -----------------------------------------------------------------
model EmplacementPublicitaire {
  emplacement_publicitaire_id String @id @default(uuid()) @db.Uuid

  code        String  @unique @db.VarChar(50)
  libelle     String  @db.VarChar(150)
  description String? @db.Text

  // v9 : un emplacement couvre une page (son code) ou un GROUPE de pages :
  // codes de pages supplémentaires où le même slider est affiché.
  pages         String[] @default([])
  // Nombre de rangs du slider (1 = première pub affichée, la plus chère).
  nombre_places Int      @default(3) @db.SmallInt
  actif         Boolean  @default(true)

  forfaits   ForfaitPublicitaire[]
  publicites Publicite[]

  @@map("emplacement_publicitaire")
}

model ForfaitPublicitaire {
  forfait_publicitaire_id String @id @default(uuid()) @db.Uuid

  emplacement_publicitaire_id String  @db.Uuid
  libelle                     String  @db.VarChar(100)
  prix                        Decimal @db.Decimal(12, 2)
  duree_jours                 Int

  // v9 : forfait échelonné par rang du slider (1 = première position) et
  // vendu dans un pays (null = forfait historique, non vendable en ligne).
  rang    Int     @default(1) @db.SmallInt
  pays_id String? @db.Uuid
  devise  String  @default("xaf") @db.VarChar(3) // minuscule, comme TransactionPaiement
  actif   Boolean @default(true)

  emplacement_publicitaire EmplacementPublicitaire @relation(fields: [emplacement_publicitaire_id], references: [emplacement_publicitaire_id])
  pays                     Pays?                   @relation(fields: [pays_id], references: [pays_id])

  lignes     LigneForfaitPublicitaire[]
  publicites Publicite[]

  @@index([emplacement_publicitaire_id])
  @@index([emplacement_publicitaire_id, pays_id, rang])
  @@map("forfait_publicitaire")
}

model LigneForfaitPublicitaire {
  ligne_id String @id @default(uuid()) @db.Uuid

  forfait_publicitaire_id String  @db.Uuid
  libelle_avantage        String  @db.VarChar(150)
  description             String? @db.Text
  ordre_affichage         Int     @db.SmallInt

  forfait_publicitaire ForfaitPublicitaire @relation(fields: [forfait_publicitaire_id], references: [forfait_publicitaire_id])

  @@index([forfait_publicitaire_id])
  @@map("ligne_forfait_publicitaire")
}

// Contrainte forte (chronogramme) conservée de l'ancien modèle :
// AUCUNE relation, ni fonctionnelle ni de données, ne doit exister
// entre publicite et les modules Urgences / gardes officielles /
// Pharmacie. Ce modèle ne référence donc jamais pharmacie,
// garde_pharmacie ni appel_urgence — voir publicite.controller.js.
model Publicite {
  publicite_id String @id @default(uuid()) @db.Uuid

  forfait_publicitaire_id     String                    @db.Uuid
  emplacement_publicitaire_id String                    @db.Uuid
  utilisateur_id              String                    @db.Uuid
  pays_id                     String                    @db.Uuid
  titre                       String                    @db.VarChar(150)
  // Le visuel est téléversé sur Cloudinary (voir lib/cloudinaryService.js,
  // fonction televerserFichier) : ce champ ne contient PAS une URL saisie
  // librement mais le "nom" (public_id) renvoyé par Cloudinary à
  // l'upload — le nom du champ est conservé tel quel (visuel_url) pour
  // ne pas casser le schéma existant, mais sa valeur est désormais
  // toujours produite par le serveur, jamais par le client. Voir
  // publicite.controller.js (creerPublicite/modifierPublicite).
  visuel_url                  String                    @db.Text
  // v9 : date_fin est EXCLUE (date_debut + duree_jours du forfait).
  date_debut                  DateTime                  @db.Date
  date_fin                    DateTime                  @db.Date
  statut_moderation           StatutModerationPublicite @default(en_attente)

  // ─── v9 : réservation d'espace (voir publicite.service.js) ───
  statut      StatutPublicite @default(en_moderation)
  rang        Int             @default(1) @db.SmallInt // copié du forfait
  description String?         @db.Text

  // Contact affiché sur la publicité.
  telephone_contact String? @db.VarChar(30)
  email_contact     String? @db.VarChar(150)
  localisation      String? @db.VarChar(255)

  // Personne qui réserve l'espace (pré-rempli depuis le compte, modifiable).
  // annonceur_telephone reçoit les messages WhatsApp.
  annonceur_nom        String? @db.VarChar(150)
  annonceur_entreprise String? @db.VarChar(150)
  annonceur_telephone  String? @db.VarChar(30)
  annonceur_email      String? @db.VarChar(150)

  // Prix figé à la soumission (prix du forfait à cette date).
  montant Decimal? @db.Decimal(12, 2)
  devise  String?  @db.VarChar(3)

  motif_rejet          String?   @db.Text
  date_soumission      DateTime  @default(now())
  date_moderation      DateTime?
  moderateur_id        String?   @db.Uuid
  date_limite_paiement DateTime?
  date_paiement        DateTime?
  transaction_id       String?   @unique @db.Uuid

  forfait_publicitaire     ForfaitPublicitaire     @relation(fields: [forfait_publicitaire_id], references: [forfait_publicitaire_id])
  emplacement_publicitaire EmplacementPublicitaire @relation(fields: [emplacement_publicitaire_id], references: [emplacement_publicitaire_id])
  utilisateur              Utilisateur             @relation(fields: [utilisateur_id], references: [utilisateur_id])
  pays                     Pays                    @relation(fields: [pays_id], references: [pays_id])

  facture      FacturePublicite?
  statistiques StatistiquePubliciteJour[]

  @@index([forfait_publicitaire_id])
  @@index([emplacement_publicitaire_id])
  @@index([utilisateur_id])
  @@index([pays_id])
  @@index([emplacement_publicitaire_id, pays_id, rang, statut])
  @@index([statut, date_limite_paiement])
  @@map("publicite")
}

// Facture d'une publicité payée : stockée (ajout seul), numérotée sans
// trou par son propre compteur annuel (FAC-PUB-AAAA-NNNNNN).
model FacturePublicite {
  facture_id     String   @id @default(uuid()) @db.Uuid
  numero         String   @unique @db.VarChar(30)
  publicite_id   String   @unique @db.Uuid
  transaction_id String   @unique @db.Uuid
  date_emission  DateTime @default(now())
  devise         String   @db.VarChar(3)
  total          Decimal  @db.Decimal(12, 2) // revenu APS, hors frais d'agrégateur
  snapshot       Json

  publicite Publicite @relation(fields: [publicite_id], references: [publicite_id])

  @@map("facture_publicite")
}

model CompteurFacturePublicite {
  annee   Int @id
  dernier Int @default(0)

  @@map("compteur_facture_publicite")
}

// Statistiques de diffusion d'une publicité, par jour UTC (portail annonceur).
model StatistiquePubliciteJour {
  publicite_id String   @db.Uuid
  jour         DateTime @db.Date
  impressions  Int      @default(0)
  clics        Int      @default(0)

  publicite Publicite @relation(fields: [publicite_id], references: [publicite_id], onDelete: Cascade)

  @@id([publicite_id, jour])
  @@map("statistique_publicite_jour")
}

// -----------------------------------------------------------------
// Pharmacie — Gardes officielles (diagramme 03_pharmacie_gardes)
//
// planning_garde porte un CALENDRIER pays (ex. "gardes janvier 2027 —
// Cameroun") ; garde_pharmacie affecte une pharmacie précise à une
// plage horaire au sein de ce planning, dans une ville donnée (v6 :
// "zone_division_id" du schéma initial devient simplement ville_id).
// appel_urgence (module 05_urgences) consomme cette table pour
// rediriger vers la garde la plus proche, mais UNIQUEMENT par relation
// fonctionnelle — pas de FK, voir la note du diagramme.
// -----------------------------------------------------------------
model PlanningGarde {
  planning_garde_id String @id @default(uuid()) @db.Uuid

  pays_id       String              @db.Uuid
  statut        StatutPlanningGarde
  periode_debut DateTime            @db.Date
  periode_fin   DateTime            @db.Date

  pays   Pays             @relation(fields: [pays_id], references: [pays_id])
  gardes GardePharmacie[]

  @@index([pays_id])
  @@map("planning_garde")
}

model GardePharmacie {
  garde_id String @id @default(uuid()) @db.Uuid

  planning_garde_id String   @db.Uuid
  pharmacie_id      String   @db.Uuid
  ville_id          String   @db.Uuid
  date_debut        DateTime
  date_fin          DateTime

  planning_garde PlanningGarde @relation(fields: [planning_garde_id], references: [planning_garde_id])
  pharmacie      Pharmacie     @relation(fields: [pharmacie_id], references: [pharmacie_id])
  ville          Ville         @relation(fields: [ville_id], references: [ville_id])

  @@index([planning_garde_id])
  @@index([pharmacie_id])
  @@index([ville_id])
  @@map("garde_pharmacie")
