// -----------------------------------------------------------------
// «ref» — Tables détenues par d'autres modules du diagramme APS,
// stubées ici (PK seule) pour que les FK ci-dessus soient valides —
// même patron que PompesFunebres / ServiceAssurance plus haut :
//   - transaction_paiement  → diagramme 06_paiement_escrow
// v8 : formule_publicitaire a été retirée de cette liste — le module
// "Présence, publicité & boost commercial" est désormais autonome et
// possède sa propre table pleinement définie, ForfaitPublicitaire
// (voir plus haut), qui n'a plus besoin d'être stubée ici.
// -----------------------------------------------------------------

// Ligne tarifaire versionnée : chaque catégorie de frais est une LIGNE
// indépendante, pas une colonne fixe. Ajouter/modifier un taux ne
// demande qu'une nouvelle ligne en base via l'API admin, jamais une
// migration.
//
// Politique de fonds v2 : seule la COMMISSION APS subsiste ici (par
// pays, prélevée à la libération vers le médecin). La taxe est
// supprimée définitivement ; les frais d'agrégateur vivent désormais
// dans FraisAgregateur (par agrégateur, pas par pays).
//
// Versionnement : pour un (pays_id, type_frais) donné, une seule ligne
// est actif=true à la fois (contrainte imposée en base, voir la
// migration — index unique partiel WHERE actif). Changer un taux ne
// réécrit jamais la ligne en cours : on désactive l'ancienne et on en
// crée une nouvelle — voir ligneTarifaire.controller.js. Les
// transactions déjà capturées référencent la ligne en vigueur au
// moment du paiement (TransactionPaiement.ligne_commission_id) et
// restent donc correctes même si le taux change ensuite.
//
// Commission APS à DEUX parts (évolution « commission patient ») :
//   - `commission`         = commission MÉDECIN (CM, ex-« Z ») : prélevée
//     sur le médecin à la libération des fonds. Valeur INCHANGÉE (pas de
//     renommage : zéro risque pour les lignes et transactions existantes).
//   - `commission_patient` = commission PATIENT (CP, ex-« Y ») : ajoutée au
//     total payé par le patient (honoraires × taux). Jamais remboursée au
//     patient, sauf défaillance du médecin ou double paiement.
// Le même index unique partiel (pays_id, type_frais) WHERE actif couvre les
// deux types : une seule ligne active par pays ET par type.
enum TypeFraisTarifaire {
  commission
  commission_patient
}

model LigneTarifaire {
  ligne_tarifaire_id  String             @id @default(uuid()) @db.Uuid
  pays_id             String             @db.Uuid
  type_frais          TypeFraisTarifaire
  libelle             String             @db.VarChar(100) // ex: "Commission APS"
  taux                Decimal            @db.Decimal(5, 4) // ex: 0.15
  actif               Boolean            @default(true)
  date_debut_validite DateTime           @default(now())

  pays Pays @relation(fields: [pays_id], references: [pays_id])

  transactions_commission         TransactionPaiement[] @relation("TransactionLigneCommission")
  transactions_commission_patient TransactionPaiement[] @relation("TransactionLigneCommissionPatient")
  commissions_versees             CommissionApsVersee[]

  @@index([pays_id, type_frais])
  @@map("ligne_tarifaire")
}

// -----------------------------------------------------------------
// Politique de fonds v2 §1 — Frais d'agrégateur, par agrégateur et par
// type. Saisis par un administrateur (aucun seed, aucune valeur codée
// en dur) : si la ligne active manque, le code lève une erreur
// explicite (voir services/fraisAgregateur.service.js, étape 2).
//
//   - envoi          : frais facturés au patient EN PLUS des honoraires.
//   - remboursement  : frais retenus sur un remboursement au patient.
//
// Les deux se calculent sur les HONORAIRES : taux × honoraires
// + montant_fixe. Jamais stockés en montant (principe « aucune valeur
// dérivée stockée ») : TransactionPaiement fige seulement la LIGNE en
// vigueur à la capture (frais_envoi_id / frais_remboursement_id).
//
// Versionnement identique à LigneTarifaire : une seule ligne active par
// (agregateur, type_frais), imposée en base par un index unique partiel
// WHERE actif (voir la migration) ; changer un frais = désactiver
// l'ancienne ligne et en créer une nouvelle.
// montant_fixe est exprimé dans la devise de la transaction (XAF pour
// CamPay).
// -----------------------------------------------------------------
enum AgregateurPaiement {
  stripe
  campay
}

enum TypeFraisAgregateur {
  envoi
  remboursement
}

model FraisAgregateur {
  frais_agregateur_id String              @id @default(uuid()) @db.Uuid
  agregateur          AgregateurPaiement
  type_frais          TypeFraisAgregateur
  libelle             String              @db.VarChar(100) // ex: "Frais d'envoi Stripe"
  taux                Decimal             @default(0) @db.Decimal(5, 4) // ex: 0.025 = 2,5 %
  montant_fixe        Decimal             @default(0) @db.Decimal(12, 2)
  actif               Boolean             @default(true)
  date_debut_validite DateTime            @default(now())

  transactions_envoi         TransactionPaiement[] @relation("TransactionFraisEnvoi")
  transactions_remboursement TransactionPaiement[] @relation("TransactionFraisRemboursement")

  @@index([agregateur, type_frais])
  @@map("frais_agregateur")
}

// -----------------------------------------------------------------
// Politique de fonds v2 §7 — Taux d'amende du médecin, par pays et
// versionné (même mécanique que LigneTarifaire : index unique partiel
// WHERE actif sur pays_id, voir la migration). Saisi par un
// administrateur, aucun seed : sans ligne active pour le pays du
// médecin, la création d'une amende échoue explicitement.
// -----------------------------------------------------------------
model ParametreAmende {
  parametre_amende_id String   @id @default(uuid()) @db.Uuid
  pays_id             String   @db.Uuid
  libelle             String   @db.VarChar(100) // ex: "Amende annulation tardive / absence"
  taux                Decimal  @db.Decimal(5, 4) // ex: 0.10 = 10 % du crédit de la prochaine libération
  actif               Boolean  @default(true)
  date_debut_validite DateTime @default(now())

  pays Pays @relation(fields: [pays_id], references: [pays_id])

  amendes AmendeMedecin[]

  @@index([pays_id])
  @@map("parametre_amende")
}

// -----------------------------------------------------------------
// ParametreDelaiLiberation — délai T (en heures) pendant lequel les
// fonds d'un RDV terminé restent en séquestre avant libération vers le
// portefeuille du médecin. Saisi par le super admin, versionné par
// pays (un seul paramètre actif par pays : index unique partiel
// parametre_delai_liberation_pays_id_actif_key, déclaré uniquement dans
// la migration car Prisma ne sait pas exprimer un index partiel). Lu au
// moment de la validation de fin de consultation puis figé sur le RDV
// (rendez_vous.delai_liberation_heures). Aucune valeur par défaut :
// sans paramètre actif pour le pays d'exercice du médecin, la fin de
// consultation échoue explicitement. Bornes (0 à 720 h) garanties par
// la contrainte CHECK parametre_delai_liberation_heures_check.
// -----------------------------------------------------------------
model ParametreDelaiLiberation {
  parametre_delai_id  String   @id @default(uuid()) @db.Uuid
  pays_id             String   @db.Uuid
  libelle             String   @db.VarChar(100) // ex: "Délai de libération des fonds"
  heures              Int // T, en heures
  actif               Boolean  @default(true)
  date_debut_validite DateTime @default(now())

  pays Pays @relation(fields: [pays_id], references: [pays_id])

  @@index([pays_id])
  @@map("parametre_delai_liberation")
}

/// @ref module 06_paiement_escrow — définition complète à fusionner
enum StatutTransactionPaiement {
  en_attente
  reussie
  echouee
  remboursee
}

model TransactionPaiement {
  transaction_id String @id @default(uuid()) @db.Uuid

  montant                    Decimal                   @db.Decimal(12, 2)
  devise                     String                    @db.VarChar(3) // code ISO 4217 minuscule, ex "xaf"
  statut                     StatutTransactionPaiement @default(en_attente)
  stripe_checkout_session_id String?                   @unique @db.VarChar(255)
  stripe_payment_intent_id   String?                   @unique @db.VarChar(255)
  date_creation              DateTime                  @default(now())
  date_mise_a_jour           DateTime                  @updatedAt

  // Fournisseur de paiement : "stripe" (défaut, historique) ou "campay".
  // Les champs campay_* / numero_payeur / rdv_id_cible ne sont renseignés
  // que pour une transaction CamPay (Mobile Money). rdv_id_cible : le RDV
  // visé, connu dès la création (l'escrow, lui, n'existe qu'après paiement).
  fournisseur      String  @default("stripe") @db.VarChar(20)
  campay_reference String? @unique @db.VarChar(100)
  campay_operator  String? @db.VarChar(30)
  numero_payeur    String? @db.VarChar(20)
  rdv_id_cible     String? @db.Uuid

  // Abonnement assurance payé par cette transaction. Sans clé étrangère,
  // comme rdv_id_cible (la cible est connue dès la création, la relation
  // métier fait foi via AbonnementAssurance.transaction_id une fois payé).
  // Une transaction vise un RDV OU un abonnement, jamais les deux
  // (contrainte CHECK transaction_objet_unique, ajoutée en SQL).
  abonnement_assurance_id_cible String? @db.Uuid

  // Abonnement de présence (pharmacie, centre de santé, médecin) payé par
  // cette transaction — même règle que abonnement_assurance_id_cible.
  // Une transaction vise UN seul objet (CHECK transaction_objet_unique).
  abonnement_presence_id_cible String? @db.Uuid

  // Publicité (réservation d'espace) payée par cette transaction — même règle.
  publicite_id_cible String? @db.Uuid

  // Décomposition du montant capturé — uniquement renseignés pour une
  // transaction liée à un rendez-vous (compte_escrow non nul) : une
  // transaction d'abonnement (medecin/pharmacie) n'a pas d'honoraires
  // ni de lignes tarifaires, d'où le caractère nullable de ces champs.
  //
  // Politique de fonds v2 : le patient paie honoraires + frais d'envoi
  // de l'agrégateur ; la commission APS est prélevée à la libération
  // vers le médecin (plus de taxe). Commission et frais ne sont JAMAIS
  // stockés en montant : ils se recalculent via montant_honoraires ×
  // ligne.taux (+ montant_fixe) à la demande — on fige seulement les
  // LIGNES en vigueur à la capture :
  //   - ligne_commission_id     : commission APS (LigneTarifaire, par pays)
  //   - frais_envoi_id          : frais d'envoi de l'agrégateur choisi
  //   - frais_remboursement_id  : frais de remboursement du même agrégateur
  //     (figés dès la capture pour que le remboursement de cette
  //     transaction ne dépende pas d'un changement de barème ultérieur)
  //
  // Commission APS à deux parts :
  //   - ligne_commission_id         : commission MÉDECIN (CM), prélevée à la
  //     libération (valeur d'enum `commission`) ;
  //   - ligne_commission_patient_id : commission PATIENT (CP), incluse dans
  //     le total payé par le patient (valeur d'enum `commission_patient`).
  //     NULL = transaction antérieure à CP : commission patient = 0, le
  //     total déjà encaissé ne change jamais (aucun backfill).
  montant_honoraires          Decimal? @db.Decimal(12, 2)
  ligne_commission_id         String?  @db.Uuid
  ligne_commission_patient_id String?  @db.Uuid
  frais_envoi_id              String?  @db.Uuid
  frais_remboursement_id      String?  @db.Uuid

  ligne_commission         LigneTarifaire?         @relation("TransactionLigneCommission", fields: [ligne_commission_id], references: [ligne_tarifaire_id])
  ligne_commission_patient LigneTarifaire?         @relation("TransactionLigneCommissionPatient", fields: [ligne_commission_patient_id], references: [ligne_tarifaire_id])
  frais_envoi              FraisAgregateur?        @relation("TransactionFraisEnvoi", fields: [frais_envoi_id], references: [frais_agregateur_id])
  frais_remboursement      FraisAgregateur?        @relation("TransactionFraisRemboursement", fields: [frais_remboursement_id], references: [frais_agregateur_id])
  abonnements_pharmacie    AbonnementPharmacie[]
  abonnements_medecin      AbonnementMedecin[]
  abonnements_assurance    AbonnementAssurance[]
  abonnements_presence     AbonnementPresence[]
  compte_escrow            CompteEscrow?
  remboursements           RemboursementPaiement[]

  // Politique de fonds v2 §5 : commissions APS effectivement conservées
  // par APS pour cette transaction (au plus une par origine : médecin,
  // patient — voir CommissionApsVersee.origine).
  commissions_aps_versees CommissionApsVersee[]

  @@index([ligne_commission_id])
  @@index([ligne_commission_patient_id])
  @@index([frais_envoi_id])
  @@index([frais_remboursement_id])
  @@index([fournisseur, statut])
  @@index([rdv_id_cible])
  @@index([abonnement_assurance_id_cible])
  @@index([abonnement_presence_id_cible])
  @@index([publicite_id_cible])
  @@map("transaction_paiement")
}

enum StatutCompteEscrow {
  sequestre
  libere
  rembourse
}

model CompteEscrow {
  escrow_id      String             @id @default(uuid()) @db.Uuid
  rdv_id         String             @unique @db.Uuid
  transaction_id String             @unique @db.Uuid
  montant        Decimal            @db.Decimal(12, 2)
  statut         StatutCompteEscrow @default(sequestre)
  date_creation  DateTime           @default(now())

  rendez_vous RendezVous          @relation(fields: [rdv_id], references: [rdv_id])
  transaction TransactionPaiement @relation(fields: [transaction_id], references: [transaction_id])

  @@map("compte_escrow")
}

// -----------------------------------------------------------------
// Phase 3 — Remboursements (politique de gestion des fonds §3-4).
// Une ligne = un remboursement réellement effectué chez Stripe : le
// montant est un FAIT (ce que Stripe a rendu au patient), jamais un
// calcul refait ici. Le "pourquoi" (>24h, <24h, défaillance) est porté
// par `motif` ; le délai lui-même n'est jamais stocké, il se
// recalcule avec RendezVous.date_creneau − date_annulation.
// -----------------------------------------------------------------
model RemboursementPaiement {
  remboursement_id String  @id @default(uuid()) @db.Uuid
  transaction_id   String  @db.Uuid
  montant          Decimal @db.Decimal(12, 2)
  motif            String  @db.VarChar(50) // annulation_precoce | annulation_tardive | defaillance_pro | litige | paiement_apres_annulation
  // Stripe : renseigné, remboursement déjà effectué (statut "effectue").
  // CamPay : NULL (pas de remboursement natif) ; la ligne naît "a_traiter"
  // et un admin effectue le retrait Mobile Money ("traite").
  stripe_refund_id String? @unique
  statut           String  @default("effectue") @db.VarChar(20) // effectue | a_traiter | traite

  // Politique de fonds v2 §2 (CamPay) : frais RÉELS du retrait Mobile
  // Money constatés par l'admin à la clôture (a_traiter -> traite).
  // Fait stocké, NULL tant que la ligne n'est pas clôturée (et toujours
  // NULL pour Stripe). Le net versé au patient = montant (brut :
  // honoraires) − frais_reels, plancher à 0 — recalculé, jamais stocké.
  frais_reels Decimal? @db.Decimal(12, 2)

  date_creation DateTime @default(now())

  transaction TransactionPaiement @relation(fields: [transaction_id], references: [transaction_id])

  @@unique([transaction_id, motif])
  @@index([transaction_id])
  @@map("remboursement_paiement")
}

// -----------------------------------------------------------------
// Phase 1 — Portefeuille médecin & grand-livre (voir politique de
// gestion des fonds §2). Principe directeur : le solde n'est JAMAIS
// une colonne stockée, il se recalcule à la demande comme la somme
// signée des mouvements du grand-livre (voir
// services/portefeuille.service.js, soldePortefeuille) — élimine tout
// risque de désynchronisation entre un solde mis en cache et la
// réalité des mouvements.
// -----------------------------------------------------------------

model PortefeuilleMedecin {
  medecin_id    String   @id @db.Uuid
  date_creation DateTime @default(now())

  medecin    Medecin                 @relation(fields: [medecin_id], references: [medecin_id])
  mouvements MouvementPortefeuille[]

  @@map("portefeuille_medecin")
}

enum TypeMouvementPortefeuille {
  credit_honoraires
  // OBSOLÈTE (politique de fonds v2) — plus jamais écrit ; conservé car
  // l'historique du grand-livre le référence (portefeuille.service.js
  // doit continuer à le sommer avec son signe d'origine).
  debit_retenue_annulation_tardive
  // OBSOLÈTE (politique de fonds v2) — remplacé par debit_amende.
  debit_frais_no_show
  debit_retrait
  // OBSOLÈTE (politique de fonds v2) — plus de frais d'annulation
  // crédités au médecin ; conservé pour l'historique.
  credit_frais_annulation
  credit_annulation_retrait // Phase 6 : retrait rejeté / échoué -> le montant réservé est recrédité
  // Politique de fonds v2 §7 : amende imputée sur une libération de
  // fonds (montant positif, signe débit — voir portefeuille.service.js).
  debit_amende
}

model MouvementPortefeuille {
  mouvement_id  String                    @id @default(uuid()) @db.Uuid
  medecin_id    String                    @db.Uuid
  type          TypeMouvementPortefeuille
  montant       Decimal                   @db.Decimal(12, 2) // toujours positif, le signe vient du type (voir portefeuille.service.js)
  date_creation DateTime                  @default(now())

  // Références vers l'événement d'origine (rendez-vous honoré, demande
  // de retrait...). Volontairement de simples colonnes UUID SANS
  // relation Prisma/FK, conformément au plan d'implémentation (Phase 1) :
  // un mouvement peut référencer soit un rdv_id (crédit honoraires,
  // retenue), soit un demande_retrait_id (débit retrait — table
  // introduite en Phase 6), jamais les deux.
  rdv_id             String? @db.Uuid
  demande_retrait_id String? @db.Uuid

  // Garantit qu'un même événement métier ne peut jamais créer deux
  // mouvements (ex. double appel de libererEscrow pour le même rdv_id) —
  // c'est cette contrainte unique qui rend l'opération idempotente,
  // voir services/portefeuille.service.js, creerMouvement.
  reference_idempotence String @unique

  portefeuille PortefeuilleMedecin @relation(fields: [medecin_id], references: [medecin_id])

  @@index([medecin_id])
  @@map("mouvement_portefeuille")
}

// -----------------------------------------------------------------
// Politique de fonds v2 §7 — Amende du médecin (annulation médecin
// < 24h, médecin absent). Une amende par RDV fautif (rdv_id unique :
// idempotence). Elle est créée `en_attente` puis imputée sur la
// PROCHAINE libération de fonds du médecin ; son montant est calculé
// à l'imputation (taux × base, voir baseCalculAmende) et n'est jamais
// stocké à la création. Due même si le RDV fautif n'avait pas
// d'escrow (elle ne dépend pas des fonds de ce RDV).
//
// Statuts :
//   - en_attente : pas encore imputée. Lors d'une libération, les amendes
//                  en attente sont imputées de la plus ancienne à la plus
//                  récente, EN ENTIER ou pas du tout ; une amende qui ne
//                  tient pas dans le crédit restant est sautée et reste
//                  en attente pour la libération suivante (pas de
//                  reliquat, pas d'imputation partielle).
//   - imputee    : intégralement imputée.
// montant_impute = montant imputé (fait), renseigné à l'imputation ; le
// mouvement correspondant est dans le grand-livre (debit_amende). Le
// montant dû se recalcule à l'imputation (taux_applique × base) et n'est
// pas stocké à la création.
// taux_applique fige le taux du ParametreAmende retenu à la création
// (parametre_amende_id garde la ligne source pour l'audit).
// -----------------------------------------------------------------
enum StatutAmende {
  en_attente
  imputee
}

model AmendeMedecin {
  amende_id           String       @id @default(uuid()) @db.Uuid
  medecin_id          String       @db.Uuid
  rdv_id              String       @unique @db.Uuid
  parametre_amende_id String       @db.Uuid
  taux_applique       Decimal      @db.Decimal(5, 4)
  statut              StatutAmende @default(en_attente)
  montant_impute      Decimal?     @db.Decimal(12, 2)
  date_creation       DateTime     @default(now())
  date_imputation     DateTime? // date de la dernière imputation

  medecin          Medecin         @relation(fields: [medecin_id], references: [medecin_id])
  rendez_vous      RendezVous      @relation(fields: [rdv_id], references: [rdv_id])
  parametre_amende ParametreAmende @relation(fields: [parametre_amende_id], references: [parametre_amende_id])

  @@index([medecin_id, statut])
  @@index([parametre_amende_id])
  @@map("amende_medecin")
}

// -----------------------------------------------------------------
// Politique de fonds v2 §1/§3/§5 — Commission APS effectivement conservée
// par APS : fait de versement. Deux origines, une ligne chacune :
//   - `medecin` (CM) : libération d'un RDV honoré, annulation patient
//     < 24h, patient absent, deux absents sans reprogrammation ;
//   - `patient` (CP) : conservée par APS dès que le patient n'est pas
//     remboursé de CP (RDV honoré, annulation/absence du patient, deux
//     absents, annulation patient > 24h, paiement tardif d'un RDV annulé
//     par le patient). Jamais écrite quand CP est rendue au patient
//     (défaillance du médecin, double paiement).
// Au plus UNE ligne par (rdv, origine) et par (transaction, origine) :
// idempotence. `ligne_commission_id` référence la ligne de taux de
// l'origine (CM : ligne_commission ; CP : ligne_commission_patient).
// Les lignes existantes prennent origine = medecin (migration).
// -----------------------------------------------------------------
enum OrigineCommissionAps {
  medecin
  patient
}

model CommissionApsVersee {
  commission_versee_id String               @id @default(uuid()) @db.Uuid
  rdv_id               String               @db.Uuid
  transaction_id       String               @db.Uuid
  origine              OrigineCommissionAps @default(medecin)
  ligne_commission_id  String               @db.Uuid
  montant              Decimal              @db.Decimal(12, 2)
  date_versement       DateTime             @default(now())

  rendez_vous      RendezVous          @relation(fields: [rdv_id], references: [rdv_id])
  transaction      TransactionPaiement @relation(fields: [transaction_id], references: [transaction_id])
  ligne_commission LigneTarifaire      @relation(fields: [ligne_commission_id], references: [ligne_tarifaire_id])

  @@unique([rdv_id, origine])
  @@unique([transaction_id, origine])
  @@index([ligne_commission_id])
  @@map("commission_aps_versee")
}

// -----------------------------------------------------------------
// Phase 6 — Retrait du médecin (décaissement Mobile Money via CamPay).
// Le montant est RÉSERVÉ dès la création de la demande (mouvement
// debit_retrait, reference_idempotence = "retrait:<id>"), dans la même
// transaction SQL que la demande, sous verrou du portefeuille. Il est
// recrédité (credit_annulation_retrait) si la demande est rejetée ou
// échoue définitivement. Voir services/retrait.service.js.
// -----------------------------------------------------------------

enum StatutDemandeRetrait {
  en_attente_validation // créée, montant réservé, en attente d'approbation admin
  en_cours // envoyée à CamPay (ou issue incertaine) : attend le résultat
  reussie
  echouee
  rejetee
}

model DemandeRetrait {
  demande_retrait_id String @id @default(uuid()) @db.Uuid
  medecin_id         String @db.Uuid

  // Simple colonne UUID sans FK : la fiche MobileMoney peut être
  // modifiée/supprimée ensuite, `numero` ci-dessous est le cliché figé.
  mobile_money_id String? @db.Uuid

  montant Decimal @db.Decimal(12, 2) // XAF, entier
  numero  String  @db.VarChar(20) // format CamPay normalisé (237XXXXXXXXX)

  titulaire_declare    String?  @db.VarChar(255) // saisi par le médecin (MobileMoney.titulaire)
  titulaire_campay     String?  @db.VarChar(255) // holder_info CamPay (best effort)
  titulaire_concordant Boolean? // null = non vérifiable

  statut           StatutDemandeRetrait @default(en_attente_validation)
  campay_reference String?              @unique @db.VarChar(100)
  motif_rejet      String?              @db.VarChar(500)
  derniere_erreur  String?              @db.VarChar(500)
  traite_par       String?              @db.Uuid // utilisateur_id de l'admin

  date_creation DateTime  @default(now())
  date_envoi    DateTime?
  date_cloture  DateTime?

  medecin Medecin @relation(fields: [medecin_id], references: [medecin_id])

  @@index([medecin_id, statut])
  @@index([statut, date_creation])
  @@map("demande_retrait")
}

/// @ref module 07_services_connexes — définition complète à fusionner
model ServiceAmbulance {
  service_ambulance_id String @id @default(uuid()) @db.Uuid

  agents AgentAmbulance[]

  @@map("service_ambulance")
}

// -----------------------------------------------------------------
// Urgences (diagramme APS — Module : Urgences)
//
// Annuaire des numéros d'urgence par pays (police, pompiers, hôpital,
// etc.), catégorisés par type_urgence. À NE PAS CONFONDRE avec la
// future table "appel_urgence" (module 05_urgences, mentionnée dans
// le commentaire de GardePharmacie plus haut) : celle-ci désignera un
// journal d'appels et se branchera fonctionnellement sur
// garde_pharmacie, sans FK. Les deux tables sont indépendantes.
//
// Lecture publique / écriture admin-superadmin — voir
// urgences.routes.js et urgences.controller.js.
// -----------------------------------------------------------------
model TypeUrgence {
  type_urgence_id String @id @default(uuid()) @db.Uuid

  libelle     String  @db.VarChar(100)
  description String? @db.Text

  urgences Urgence[]

  @@map("type_urgence")
}

model Urgence {
  urgence_id String @id @default(uuid()) @db.Uuid

  type_urgence_id String  @db.Uuid
  pays_id         String  @db.Uuid
  libelle         String  @db.VarChar(150)
  description     String? @db.Text
  telephone       String  @db.VarChar(20)

  type_urgence TypeUrgence @relation(fields: [type_urgence_id], references: [type_urgence_id])
  pays         Pays        @relation(fields: [pays_id], references: [pays_id])

  @@index([type_urgence_id])
  @@index([pays_id])
  @@map("urgence")
}

// =====================================================================
// APS — Module transverse : Gestion des médecins
//
// Le médecin est un compte "utilisateur" spécialisé (role='medecin'),
// publié après vérification (statut_verification, porté par le
// modèle Medecin déjà défini plus haut dans ce fichier — section IAM).
// Il peut exercer en présentiel et/ou en téléconsultation
// (teleconsultation_activee), recevoir des avis publics, honorer des
// rendez-vous et émettre des ordonnances. Contrairement aux autres
// types de services, il est EXCLU de la publicité : seul l'abonnement
// de présence forfaitaire (abonnement_medecin) lui est ouvert.
// =====================================================================

// -----------------------------------------------------------------
// Avis (même patron de modération que AvisPharmacie : un avis déposé
// n'est jamais visible publiquement avant validation par un
// admin/superadmin — réutilise l'enum générique StatutModerationAvis).
// -----------------------------------------------------------------
model AvisMedecin {
  avis_id String @id @default(uuid()) @db.Uuid

  utilisateur_id    String               @db.Uuid
  medecin_id        String               @db.Uuid
  note              Int                  @db.SmallInt
  commentaire       String?              @db.Text
  statut_moderation StatutModerationAvis @default(en_attente)
  date_creation     DateTime             @default(now())

  // Réputation médecin (19/10) — un avis est déposé par un PATIENT au
  // titre d'une consultation réellement terminée (rendez_vous.termine_le),
  // au plus un avis par RDV. NULL = avis antérieur à cette règle (affiché,
  // mais sans le badge « patient vérifié »). Voir services/avisMedecin.service.js.
  rdv_id String? @unique @db.Uuid

  // Critères facultatifs (1 à 5) et recommandation : la note globale
  // reste la seule note obligatoire et la seule qui entre dans la moyenne.
  note_ponctualite  Int?      @db.SmallInt
  note_ecoute       Int?      @db.SmallInt
  note_explications Int?      @db.SmallInt
  recommande        Boolean?
  // Le patient choisit d'apparaître sous la mention « Patient vérifié »
  // plutôt que « Prénom N. ».
  anonyme           Boolean   @default(false)
  date_moderation   DateTime?

  // Réponse publique du médecin (une seule, modifiable), visible sous
  // l'avis publié.
  reponse_medecin String?   @db.Text
  date_reponse    DateTime?

  // Signalement par le médecin (contenu abusif, faux patient...) : remonte
  // au back-office, l'avis reste en ligne tant qu'un admin n'a pas tranché.
  signale_le        DateTime?
  motif_signalement String?   @db.Text

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])
  medecin     Medecin     @relation(fields: [medecin_id], references: [medecin_id])
  rendez_vous RendezVous? @relation(fields: [rdv_id], references: [rdv_id])

  @@index([utilisateur_id])
  @@index([medecin_id])
  @@index([medecin_id, statut_moderation, date_creation])
  @@map("avis_medecin")
}

// -----------------------------------------------------------------
// Abonnement de présence forfaitaire (même patron que
// AbonnementPharmacie) : toujours adossé à une transaction_paiement
// déjà réglée (module 06_paiement_escrow, table «ref» stubée plus
// haut). ligne_abonnement_medecin détaille les avantages inclus.
//
// v9 : abonnement_medecin est désormais une entité INDÉPENDANTE du
// médecin — ce n'est plus une ligne portée par un medecin_id direct,
// mais une offre commerciale (ex. "Présence Premium 30 jours") qui
// peut être souscrite par PLUSIEURS médecins, et un médecin peut lui
// même souscrire à PLUSIEURS abonnements (successifs ou simultanés).
// Cette relation N-N est portée par la table de jointure
// forfait_abonnement_medecin, voir juste après.
// -----------------------------------------------------------------
model AbonnementMedecin {
  abonnement_id String @id @default(uuid()) @db.Uuid

  libelle        String                  @db.VarChar(100)
  montant        Decimal                 @db.Decimal(12, 2)
  duree_jours    Int
  date_debut     DateTime                @db.Date
  date_fin       DateTime                @db.Date
  transaction_id String                  @db.Uuid
  statut         StatutAbonnementMedecin

  transaction TransactionPaiement @relation(fields: [transaction_id], references: [transaction_id])

  lignes   LigneAbonnementMedecin[]
  // v9 : médecin(s) souscripteur(s) de cet abonnement — voir
  // ForfaitAbonnementMedecin.
  forfaits ForfaitAbonnementMedecin[]

  @@index([transaction_id])
  @@map("abonnement_medecin")
}

// Table de jointure N-N medecin <-> abonnement_medecin (v9). Un
// médecin peut souscrire plusieurs abonnements, et un même abonnement
// peut être souscrit par plusieurs médecins (ex. offre groupée pour
// un cabinet). La contrainte unique [medecin_id, abonnement_id]
// empêche qu'un médecin soit rattaché deux fois au même abonnement.
model ForfaitAbonnementMedecin {
  forfait_abonnement_medecin_id String @id @default(uuid()) @db.Uuid

  medecin_id    String   @db.Uuid
  abonnement_id String   @db.Uuid
  date_creation DateTime @default(now())

  medecin    Medecin           @relation(fields: [medecin_id], references: [medecin_id])
  abonnement AbonnementMedecin @relation(fields: [abonnement_id], references: [abonnement_id])

  @@unique([medecin_id, abonnement_id])
  @@index([medecin_id])
  @@index([abonnement_id])
  @@map("forfait_abonnement_medecin")
}

model LigneAbonnementMedecin {
  ligne_id String @id @default(uuid()) @db.Uuid

  abonnement_id    String  @db.Uuid
  libelle_avantage String  @db.VarChar(150)
  description      String? @db.Text
  ordre_affichage  Int     @db.SmallInt

  abonnement AbonnementMedecin @relation(fields: [abonnement_id], references: [abonnement_id])

  @@index([abonnement_id])
  @@map("ligne_abonnement_medecin")
}

// -----------------------------------------------------------------
// Rendez-vous — pivot du module : relie patient et médecin, en
// présentiel (structure_id renseigné, cabinet ou structure de santé)
// ou en téléconsultation (structure_id nullable). code_unique et
// qr_token_secret servent au contrôle de présence à l'accueil
// (scan/QR) — voir le diagramme pour le détail du parcours.
//
// Le séquestre des fonds (compte_escrow, module 06_paiement_escrow)
// est fonctionnellement rattaché à chaque rendez-vous mais n'est pas
// modélisé par une FK ici : voir la note sur CompteEscrow plus haut.
// -----------------------------------------------------------------
model RendezVous {
  rdv_id String @id @default(uuid()) @db.Uuid

  patient_id      String           @db.Uuid
  medecin_id      String           @db.Uuid
  structure_id    String?          @db.Uuid
  type_rdv        TypeRdv
  date_creneau    DateTime
  statut          StatutRendezVous
  motif           String?          @db.Text
  code_unique     String           @unique @db.VarChar(8)
  qr_token_secret String           @db.Text

  // Phase 3 — annulation motivée (politique de gestion des fonds §3).
  // date_annulation est un FAIT constaté ; le fait que l'annulation
  // ait eu lieu à plus ou moins de 24h du créneau se recalcule à la
  // volée (date_creneau − date_annulation), jamais stocké.
  motif_annulation       MotifAnnulation?
  commentaire_annulation String?           @db.Text
  date_annulation        DateTime?
  // Qui a annulé (fait constaté, y compris quand un admin annule au nom
  // d'une partie). Nécessaire à la règle « paiement tardif » : si le
  // médecin a annulé, il est fautif et CP est rendue au patient. NULL =
  // RDV annulé avant cette colonne ou jamais annulé (traité « patient »).
  annule_par             PartieRendezVous?

  // Politique de fonds v2 §5 — présences : FAITS enregistrés (jamais un
  // « absent » stocké) ; l'absence se déduit de l'absence d'horodatage.
  // Aucun horodatage du tout => les deux sont traités absents.
  medecin_present_le DateTime?
  patient_present_le DateTime?

  // Politique de fonds v2 §5 — reprogrammation (deux absents).
  //   - a_reprogrammer_le : date d'entrée en statut a_reprogrammer, point
  //     de départ du délai de 48h (fait ; l'échéance se recalcule).
  //   - nouvelle_date_proposee / proposee_par / date_proposition : la
  //     proposition en cours (une nouvelle proposition remplace la
  //     précédente, sans prolonger le délai). L'autre partie l'accepte.
  a_reprogrammer_le      DateTime?
  nouvelle_date_proposee DateTime?
  proposee_par           PartieRendezVous?
  date_proposition       DateTime?

  // Libération différée des fonds — fin de consultation constatée (code
  // validé par le médecin, ou clôture de la visio) : FAIT horodaté. La
  // date de libération se RECALCULE (termine_le + delai_liberation_heures),
  // elle n'est jamais stockée. NULL = consultation pas encore terminée.
  termine_le              DateTime?
  // T (en heures) figé à la validation, lu dans parametre_delai_liberation
  // (comme taux_applique pour les amendes) : une modification ultérieure
  // de T ne touche pas les RDV déjà terminés.
  delai_liberation_heures Int?

  // Protection anti force-brute sur la saisie du code par le médecin :
  // compteur d'échecs consécutifs et verrou temporaire.
  tentatives_code_echouees Int       @default(0)
  code_verrouille_jusqu_a  DateTime?

  // Agenda — réservation d'un créneau en attente de confirmation (statut
  // « cree », non payé). FAITS : date de création du RDV et délai H (en
  // heures) figé à la création, lu dans parametre_delai_confirmation
  // (4 h par défaut). L'échéance se RECALCULE (min(date_creation + H,
  // date_creneau), voir src/lib/delaiConfirmation.js), jamais stockée.
  // À l'échéance, le cron annule le RDV (motif delai_confirmation_expire)
  // et le créneau redevient disponible. NULL = RDV antérieur à ce module :
  // le délai actif du pays s'applique.
  date_creation             DateTime @default(now())
  delai_confirmation_heures Int?

  // Acceptation d'un RDV PHYSIQUE par le médecin, APRÈS paiement (statut
  // « confirme » : le médecin n'agit jamais sur un RDV non payé, D8). FAITS :
  //   - lieu_rdv   : lieu de la consultation, saisi librement par le
  //     médecin ; obligatoire pour accepter, modifiable tant que le RDV
  //     est « confirme » (le patient est notifié à chaque changement) ;
  //   - accepte_le : date de la PREMIÈRE acceptation.
  // Pas de statut dédié : « accepté » = accepte_le renseigné. Sans
  // acceptation, rien d'automatique (le médecin peut annuler). NULL pour
  // une téléconsultation.
  lieu_rdv   String?   @db.VarChar(500)
  accepte_le DateTime?

  patient   Patient         @relation(fields: [patient_id], references: [patient_id])
  medecin   Medecin         @relation(fields: [medecin_id], references: [medecin_id])
  structure StructureSante? @relation(fields: [structure_id], references: [structure_id])

  ordonnances Ordonnance[]

  // Créneau d'agenda occupé par ce rendez-vous (voir CreneauAgenda
  // plus bas). Nullable : un rendez-vous historique ou créé avant le
  // module Agenda peut ne pas être rattaché à un créneau.
  creneau_agenda CreneauAgenda?
  // Séquestre Stripe de ce rendez-vous (1-1, créé par le webhook
  // checkout.session.completed — voir paiement.controller.js).
  compte_escrow  CompteEscrow?

  // Politique de fonds v2 : amende due par le médecin pour ce RDV (au plus
  // une) et commissions APS conservées (au plus une par origine : médecin,
  // patient — voir CommissionApsVersee).
  amende_medecin          AmendeMedecin?
  commissions_aps_versees CommissionApsVersee[]

  // Étape 6 : notifications in-app liées à ce RDV (reprogrammation).
  notifications Notification[]

  // Avis laissé par le patient au titre de ce RDV (au plus un).
  avis_medecin AvisMedecin?

  // Politique de fonds v2 §6 : un index unique PARTIEL sur
  // (medecin_id, date_creneau) pour les RDV actifs (statuts cree,
  // confirme, en_attente_presence, a_reprogrammer) interdit deux RDV
  // actifs sur le même créneau d'un médecin. Prisma ne sait pas
  // exprimer un index partiel : il n'est déclaré que dans la migration
  // (nom : rendez_vous_medecin_creneau_actif_key), comme l'index
  // partiel de LigneTarifaire.
  // RDV aléatoire : offre dont ce RDV est issu (au plus une).
  offre_rdv OffreRdv?

  @@index([patient_id])
  @@index([medecin_id])
  @@index([structure_id])
  @@index([statut])
  @@map("rendez_vous")
}

// -----------------------------------------------------------------
// Notification — Politique de fonds v2 §5, étape 6 (point ouvert E).
// Canal in-app uniquement (aucune infrastructure e-mail/push n'existe
// dans le dépôt) ; notification.service.js est le point unique
// d'émission, un canal e-mail/push pourra s'y brancher sans toucher aux
// appelants. On stocke des FAITS d'émission :
//   - cle : clé d'idempotence unique (ex. « a_reprogrammer:<rdv>:<date
//     d'entrée en a_reprogrammer>:<utilisateur> ») — un rejeu du cron ou
//     une reprise après échec ne crée jamais de doublon, et un second
//     cycle de reprogrammation du même RDV produit de nouvelles lignes ;
//   - donnees : uniquement ce qui ne se retrouve plus ailleurs (la date
//     proposée, remplacée par une contre-proposition) — jamais l'échéance
//     des 48h, qui se recalcule (a_reprogrammer_le + 48h).
// -----------------------------------------------------------------
model Notification {
  notification_id String @id @default(uuid()) @db.Uuid

  utilisateur_id String           @db.Uuid
  type           TypeNotification
  rdv_id         String?          @db.Uuid
  titre          String           @db.VarChar(200)
  message        String           @db.Text
  donnees        Json?
  cle            String           @unique @db.VarChar(255)

  lue_le        DateTime?
  date_creation DateTime  @default(now())
  // Push mobile (FCM) : posé quand l'envoi a été pris en charge — une
  // notification n'est poussée qu'une fois, même si sa clé est rejouée.
  push_envoye_le DateTime?

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])
  rendez_vous RendezVous? @relation(fields: [rdv_id], references: [rdv_id])

  @@index([utilisateur_id, lue_le, date_creation])
  @@index([rdv_id])
  @@map("notification")
}

// -----------------------------------------------------------------
// Push mobile : jeton FCM d'une installation de l'application, rattaché
// au compte connecté (enregistré à la connexion, retiré à la
// déconnexion ou quand FCM le déclare invalide). Un jeton n'appartient
// qu'à un compte à la fois : une reconnexion avec un autre compte sur le
// même téléphone le réattribue.
// -----------------------------------------------------------------
model AppareilPush {
  appareil_push_id String   @id @default(uuid()) @db.Uuid
  utilisateur_id   String   @db.Uuid
  jeton            String   @unique @db.VarChar(512)
  plateforme       String   @db.VarChar(20)
  date_creation    DateTime @default(now())
  date_maj         DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id], onDelete: Cascade)

  @@index([utilisateur_id])
  @@map("appareil_push")
}

// -----------------------------------------------------------------
// Ordonnance — émise par le médecin à l'issue d'un rendez-vous.
// identifiant_unique sert de référence de vérification externe (ex :
// consultée par une pharmacie). pays_emission_id peut différer du
// pays d'exercice du médecin en téléconsultation transfrontalière,
// d'où une FK dédiée vers Pays plutôt qu'une réutilisation de
// medecin.pays_exercice_id.
// -----------------------------------------------------------------
model Ordonnance {
  ordonnance_id String @id @default(uuid()) @db.Uuid

  rdv_id             String   @db.Uuid
  medecin_id         String   @db.Uuid
  patient_id         String   @db.Uuid
  identifiant_unique String   @unique @db.VarChar(50)
  pays_emission_id   String   @db.Uuid
  contenu            String   @db.Text
  date_emission      DateTime @default(now())

  rendez_vous   RendezVous @relation(fields: [rdv_id], references: [rdv_id])
  medecin       Medecin    @relation(fields: [medecin_id], references: [medecin_id])
  patient       Patient    @relation(fields: [patient_id], references: [patient_id])
  pays_emission Pays       @relation(fields: [pays_emission_id], references: [pays_id])

  @@index([rdv_id])
  @@index([medecin_id])
  @@index([patient_id])
  @@index([pays_emission_id])
  @@map("ordonnance")
}

// =====================================================================
// APS — Module transverse : Agenda du médecin
//
// Deux niveaux, comme pour les autres relations N-N du fichier
// (cf. ForfaitAbonnementMedecin) :
//   - DisponibiliteMedecin : le GABARIT récurrent — "ce médecin
//     reçoit tous les lundis sur ce créneau". Table de jointure N-N
//     entre Medecin et Horaire, portant en plus le jour de la
//     semaine.
//   - CreneauAgenda : les instances CONCRÈTES par date réelle,
//     générées côté application à partir du gabarit (job récurrent
//     ou génération à la volée). C'est cette table qui porte le
//     statut réel du créneau et qui se rattache, le cas échéant, au
//     rendez-vous qui l'occupe.
//
// La gestion des indisponibilités ponctuelles (congé, urgence) n'est
// pas encore branchée : StatutCreneauAgenda prévoit déjà la valeur
// "bloque" pour ça, il n'y aura pas de migration de structure à
// prévoir le jour où on l'active.
// =====================================================================

// -----------------------------------------------------------------
// Horaire : référentiel des tranches de 30 minutes (ex. 07h00-07h30,
// 07h30-08h00, ..., jusqu'à 20h00). Une seule fois pour tous les
// médecins, réutilisée par DisponibiliteMedecin et CreneauAgenda.
// -----------------------------------------------------------------
model Horaire {
  horaire_id String @id @default(uuid()) @db.Uuid

  heure_debut DateTime @db.Time
  heure_fin   DateTime @db.Time

  disponibilites  DisponibiliteMedecin[]
  creneaux_agenda CreneauAgenda[]

  @@unique([heure_debut, heure_fin])
  @@map("horaire")
}

// -----------------------------------------------------------------
// DisponibiliteMedecin : table de jointure N-N medecin <-> horaire,
// portant en plus jour_semaine. C'est le gabarit récurrent déclaré
// par le médecin (ex. "disponible le lundi de 09h00 à 09h30"). La
// contrainte unique empêche une déclaration en double du même
// créneau, le même jour, pour le même médecin.
// -----------------------------------------------------------------
model DisponibiliteMedecin {
  disponibilite_id String @id @default(uuid()) @db.Uuid

  medecin_id   String      @db.Uuid
  horaire_id   String      @db.Uuid
  jour_semaine JourSemaine

  medecin Medecin @relation(fields: [medecin_id], references: [medecin_id])
  horaire Horaire @relation(fields: [horaire_id], references: [horaire_id])

  @@unique([medecin_id, horaire_id, jour_semaine])
  @@index([medecin_id])
  @@index([horaire_id])
  @@map("disponibilite_medecin")
}

// -----------------------------------------------------------------
// CreneauAgenda : instance concrète d'un créneau pour une date
// précise, générée à partir de DisponibiliteMedecin. C'est cette
// table qui répond à la question "le médecin X est-il libre le 6
// octobre à 14h ?" et qui se rattache au rendez-vous qui l'occupe le
// cas échéant (rendez_vous, relation 1-1 optionnelle portée par
// RendezVous.creneau_agenda plus haut).
// -----------------------------------------------------------------
model CreneauAgenda {
  creneau_id String @id @default(uuid()) @db.Uuid

  medecin_id String               @db.Uuid
  horaire_id String               @db.Uuid
  date       DateTime             @db.Date
  statut     StatutCreneauAgenda  @default(disponible)
  origine    OrigineCreneauAgenda @default(genere)
  rdv_id     String?              @unique @db.Uuid

  medecin     Medecin     @relation(fields: [medecin_id], references: [medecin_id])
  horaire     Horaire     @relation(fields: [horaire_id], references: [horaire_id])
  rendez_vous RendezVous? @relation(fields: [rdv_id], references: [rdv_id])

  @@unique([medecin_id, horaire_id, date])
  @@index([medecin_id])
  @@index([horaire_id])
  @@index([date])
  @@map("creneau_agenda")
}

// -----------------------------------------------------------------
// ParametreDelaiConfirmation : délai H (heures) pendant lequel un
// rendez-vous « cree » (pas encore confirmé = pas encore payé) garde
// son créneau réservé. Passé ce délai (ou l'heure du créneau, si elle
// arrive avant), le RDV est annulé automatiquement et le créneau
// redevient visible. PAR PAYS (pays d'exercice du médecin), VERSIONNÉ
// (même mécanique que ParametreDelaiLiberation : jamais d'UPDATE, on
// désactive l'actif et on en crée un nouveau). Sans paramètre actif,
// 4 h par défaut (DELAI_CONFIRMATION_PAR_DEFAUT_H). Un seul actif par
// pays : index unique PARTIEL déclaré dans la migration.
// -----------------------------------------------------------------
model ParametreDelaiConfirmation {
  parametre_delai_confirmation_id String   @id @default(uuid()) @db.Uuid
  pays_id                         String   @db.Uuid
  libelle                         String   @db.VarChar(100)
  heures                          Int
  actif                           Boolean  @default(true)
  date_debut_validite             DateTime @default(now())

  pays Pays @relation(fields: [pays_id], references: [pays_id])

  @@index([pays_id])
  @@map("parametre_delai_confirmation")
}

// =====================================================================
// APS — Module transverse : Moyens de paiement du médecin
// (Mobile Money & Compte Bancaire)
// =====================================================================

// -----------------------------------------------------------------
// TypeMobileMoney : Référentiel des opérateurs de mobile money par pays
// -----------------------------------------------------------------
model TypeMobileMoney {
  id String @id @default(uuid()) @db.Uuid

  pays_id String @db.Uuid
  libelle String @db.VarChar(100)

  pays          Pays          @relation(fields: [pays_id], references: [pays_id])
  mobile_moneys MobileMoney[]

  @@index([pays_id])
  @@map("type_mobile_money")
}

// -----------------------------------------------------------------
// MobileMoney : Coordonnées de paiement mobile money d'un médecin
// -----------------------------------------------------------------
model MobileMoney {
  id String @id @default(uuid()) @db.Uuid

  // Correspond à "id_typemobilemoney" de la demande
  type_mobile_money_id String @db.Uuid
  // Correspond à "id_medecin" de la demande
  medecin_id           String @db.Uuid

  numero    String @db.VarChar(50)
  titulaire String @db.VarChar(255)

  // Numéro de réception actif : un seul par médecin (activer un numéro
  // désactive les autres, voir moyenPaiement.controller.js). Les retraits
  // partent vers ce numéro.
  actif         Boolean  @default(false)
  date_creation DateTime @default(now())

  type_mobile_money TypeMobileMoney @relation(fields: [type_mobile_money_id], references: [id])
  medecin           Medecin         @relation(fields: [medecin_id], references: [medecin_id])

  @@index([type_mobile_money_id])
  @@index([medecin_id])
  @@map("mobile_money")
}

// -----------------------------------------------------------------
// CompteBancaire : Coordonnées bancaires d'un médecin
// -----------------------------------------------------------------
model CompteBancaire {
  id String @id @default(uuid()) @db.Uuid

  // Correspond à "id_medecin" de la demande
  medecin_id String @db.Uuid

  nom_banque String @db.VarChar(150)
  titulaire  String @db.VarChar(255)
  iban       String @db.VarChar(100)

  medecin Medecin @relation(fields: [medecin_id], references: [medecin_id])

  @@index([medecin_id])
  @@map("compte_bancaire")
}

// -----------------------------------------------------------------
// CompteStripeConnect : compte Stripe Connect (Express) d'un médecin,
// pour recevoir ses paiements par carte bancaire / compte bancaire.
// Les coordonnées (numéro de carte, IBAN) sont saisies sur la page
// hébergée de Stripe et ne transitent jamais par ApSa (PCI-DSS) : on ne
// conserve que l'identifiant du compte et un résumé affichable.
// -----------------------------------------------------------------
model CompteStripeConnect {
  id String @id @default(uuid()) @db.Uuid

  medecin_id        String @unique @db.Uuid
  stripe_account_id String @unique @db.VarChar(255)

  // Miroir des drapeaux Stripe (resynchronisés à chaque consultation).
  details_soumis       Boolean @default(false)
  paiements_actives    Boolean @default(false) // charges_enabled
  virements_actives    Boolean @default(false) // payouts_enabled
  exigences_en_attente Int     @default(0) // requirements.currently_due.length

  // Résumé du moyen de réception enregistré chez Stripe (jamais complet).
  type_externe      String? @db.VarChar(20) // "card" | "bank_account"
  marque_externe    String? @db.VarChar(100) // marque de carte ou nom de banque
  derniers_chiffres String? @db.VarChar(4)
  devise            String? @db.VarChar(3)
  pays              String? @db.VarChar(2)

  date_creation    DateTime  @default(now())
  date_mise_a_jour DateTime  @updatedAt
  date_synchro     DateTime?

  medecin Medecin @relation(fields: [medecin_id], references: [medecin_id], onDelete: Cascade)

  @@map("compte_stripe_connect")
}

// GESTION DES APKS DE L'APPLICATION MOBILE 

model MobileApk {
  id String @id @default(uuid()) @db.Uuid

  libelle     String   @db.VarChar(255)
  description String?  @db.Text
  file_url    String   @db.Text
  status      Boolean  @default(true)
  date_upload DateTime @default(now())

  @@map("mobile_apk")
}

model Annonce {
  id String @id @default(uuid()) @db.Uuid

  libelle            String   @db.VarChar(255)
  description        String?  @db.Text
  courte_description String?  @db.Text
  file_url           String?  @db.Text
  date_creation      DateTime @default(now())
  jour_validite      Int
  statut             Boolean  @default(true)

  @@map("annonce")
}

// =====================================================================
// Abonnements des assurances (guide_implementation_abonnement_assurances
// v3, §1.1.1 et §1.2)
//
// Principe : le serveur décide des droits d'une fiche à partir de son
// abonnement valide (voir lib/droitsAssurance.js) ; sans abonnement, la
// fiche n'a qu'une présence minimale. Les prix vivent dans la grille de
// tarifs, jamais sur le niveau.
//
// Contraintes que Prisma ne sait pas exprimer (CHECK, index uniques
// partiels, déclencheurs d'ajout seul) : elles sont créées en SQL dans
// les migrations 20261013100000 et 20261013100100.
// =====================================================================

// Journal d'audit immuable (EF-AUD-01). Ajout seul : un déclencheur SQL
// interdit UPDATE et DELETE (voir la migration journal_audit).
model JournalAudit {
  audit_id      String   @id @default(uuid()) @db.Uuid
  date_creation DateTime @default(now())
  acteur_id     String?  @db.Uuid // null = système (webhook, cron)
  type          String   @db.VarChar(60) // ex. ABONNEMENT_ASSURANCE_ACTIVE
  objet_type    String   @db.VarChar(40)
  objet_id      String?  @db.Uuid
  details       Json?

  @@index([objet_type, objet_id])
  @@index([type, date_creation])
  @@map("journal_audit")
}

enum StatutAbonnementAssurance {
  en_attente_paiement // brouillon créé au clic « Payer », sans date
  actif
  expire
  annule
  suspendu
  remplace // remplacé par une montée de niveau
}

enum OrigineAbonnementAssurance {
  self_service
  admin
  virement
  geste
  gratuite
}

model NiveauAbonnementAssurance {
  niveau_id String @id @default(uuid()) @db.Uuid

  code    String  @unique @db.VarChar(30) // "enrichie", "premium"
  libelle String  @db.VarChar(100)
  rang    Int // 1 = le plus bas (unicité vérifiée par l'API) ; sert à comparer montée / descente
  actif   Boolean @default(true) // actif = vendable. N'affecte PAS les abonnés en cours.

  // Drapeaux d'avantages (cochés par l'admin)
  siege_complet      Boolean @default(true)
  afficher_activites Boolean @default(true)
  afficher_agences   Boolean @default(true)
  formulaire_contact Boolean @default(true)
  suivi_demandes     Boolean @default(true) // statut + note interne des demandes (portail assurance)
  // Appliqués par le portail assurance (médiathèque, tableau de bord).
  video_presentation Boolean @default(false) // vidéos de la médiathèque visibles du public
  stats_completes    Boolean @default(false) // courbe quotidienne des vues et des demandes
  // RÉSERVÉS : stockés mais non appliqués tant que le modèle de données
  // manque (phase 9).
  vitrine_premium    Boolean @default(false)
  export_stats       Boolean @default(false)

  // Quotas (null = illimité)
  max_agences       Int?
  max_photos        Int? // photos de la médiathèque visibles du public
  max_gestionnaires Int? // réservé

  abonnements AbonnementAssurance[]
  tarifs      TarifAbonnementAssurance[]

  @@map("niveau_abonnement_assurance")
}

model AbonnementAssurance {
  abonnement_id String @id @default(uuid()) @db.Uuid

  service_assurance_id String @db.Uuid
  niveau_id            String @db.Uuid

  // Figés à la création du brouillon (une modification de grille n'est
  // jamais rétroactive).
  duree_mois            Int
  prix_mensuel_applique Decimal @db.Decimal(12, 2)
  remise_pourcent       Decimal @default(0) @db.Decimal(5, 2)
  credit_prorata        Decimal @default(0) @db.Decimal(12, 2) // montée de niveau
  montant_total         Decimal @db.Decimal(12, 2)
  devise                String  @db.VarChar(3) // minuscule, comme TransactionPaiement ("xaf")

  // Renseignées à l'activation. date_fin est EXCLUSIVE : premier jour
  // non couvert.
  date_debut DateTime?                 @db.Date
  date_fin   DateTime?                 @db.Date
  statut     StatutAbonnementAssurance @default(en_attente_paiement)

  abonnement_remplace_id String? @db.Uuid // montée de niveau : l'abonnement remplacé
  dernier_rappel_jours   Int? // 30, 7 ou 1 : dernier rappel d'échéance envoyé

  transaction_id String?                    @db.Uuid // null : brouillon, geste commercial, gratuité
  motif          String?                    @db.Text // obligatoire pour geste / prolongation
  origine        OrigineAbonnementAssurance @default(self_service)

  date_creation    DateTime @default(now())
  date_mise_a_jour DateTime @updatedAt

  service     ServiceAssurance            @relation(fields: [service_assurance_id], references: [service_assurance_id])
  niveau      NiveauAbonnementAssurance   @relation(fields: [niveau_id], references: [niveau_id])
  transaction TransactionPaiement?        @relation(fields: [transaction_id], references: [transaction_id])
  facture     FactureAbonnementAssurance?

  @@index([service_assurance_id, statut])
  @@index([statut, date_fin])
  @@index([niveau_id])
  @@index([transaction_id])
  @@map("abonnement_assurance")
}

// Grille de prix : niveau × pays × type d'acteur. type_acteur NULL =
// tarif générique. L'unicité (qui doit tenir compte des NULL) est portée
// par deux index uniques PARTIELS créés en SQL, pas par @@unique.
model TarifAbonnementAssurance {
  tarif_id           String               @id @default(uuid()) @db.Uuid
  niveau_id          String               @db.Uuid
  pays_id            String               @db.Uuid
  type_acteur        TypeActeurAssurance? // null = tous
  devise             String               @db.VarChar(3) // "xaf" au Cameroun (CamPay n'accepte que XAF)
  prix_mensuel       Decimal              @db.Decimal(12, 2)
  prix_usd_indicatif Decimal?             @db.Decimal(12, 2)
  actif              Boolean              @default(true)

  niveau NiveauAbonnementAssurance @relation(fields: [niveau_id], references: [niveau_id])
  pays   Pays                      @relation(fields: [pays_id], references: [pays_id])

  @@index([niveau_id, pays_id])
  @@index([pays_id])
  @@map("tarif_abonnement_assurance")
}

model RemiseDureeAbonnementAssurance {
  duree_mois      Int     @id // 1, 3, 6, 12
  remise_pourcent Decimal @db.Decimal(5, 2)

  @@map("remise_duree_abonnement_assurance")
}

// Gratuité d'amorçage et durée de grâce, par pays (EF-ADM-03).
model ConfigAbonnementAssurance {
  pays_id            String    @id @db.Uuid
  gratuite_active    Boolean   @default(false)
  gratuite_niveau_id String?   @db.Uuid
  gratuite_jusqu_au  DateTime? @db.Date
  grace_jours        Int       @default(7)

  pays Pays @relation(fields: [pays_id], references: [pays_id])

  @@map("config_abonnement_assurance")
}

// Facture archivée, numérotée sans trou (EF-PAY-13). Ajout seul
// (déclencheur SQL).
model FactureAbonnementAssurance {
  facture_id     String   @id @default(uuid()) @db.Uuid
  numero         String   @unique @db.VarChar(30) // FAC-ABO-2026-000123
  abonnement_id  String   @unique @db.Uuid
  transaction_id String   @unique @db.Uuid
  date_emission  DateTime @default(now())
  devise         String   @db.VarChar(3)
  total          Decimal  @db.Decimal(12, 2)
  snapshot       Json // contenu immuable au moment de l'émission

  abonnement AbonnementAssurance @relation(fields: [abonnement_id], references: [abonnement_id])

  @@map("facture_abonnement_assurance")
}

// Compteur annuel verrouillé (INSERT ... ON CONFLICT DO UPDATE) : une
// séquence PostgreSQL laisserait des trous en cas d'annulation.
model CompteurFactureAbonnement {
  annee   Int @id
  dernier Int @default(0)

  @@map("compteur_facture_abonnement")
}

// =====================================================================
// Abonnements de présence : pharmacies, centres de santé, médecins
// (cahier des charges v3, « APS — Abonnements de présence »).
//
// Même moteur que les abonnements assurance (niveaux à drapeaux, grille
// niveau × pays, remises de durée, gratuité d'amorçage, grâce, facture
// numérotée), mutualisé pour les trois types d'acteur : chaque ligne
// porte son type_acteur. L'abonnement n'apporte AUCUN avantage de
// classement : il ne fait qu'enrichir la fiche (lib/droitsPresence.js).
//
// Médecins : l'obligation de souscrire se décide PAR PAYS
// (ConfigAbonnementPresence.abonnement_obligatoire). Désactivée, un
// médecin garde tous ses droits sans abonnement.
//
// Contraintes SQL hors Prisma (CHECK, index uniques partiels, ajout
// seul) : migration 20261017120100_abonnement_presence.
// =====================================================================

enum TypeActeurPresence {
  pharmacie
  structure
  medecin
  // Utilisé UNIQUEMENT par le compteur de vues (VueFiche) : les assurances
  // ont leur propre moteur d'abonnement (AbonnementAssurance). Jamais
  // accepté par l'API des abonnements de présence (TYPES_ACTEUR_PRESENCE).
  assurance
}

model NiveauAbonnementPresence {
  niveau_id String @id @default(uuid()) @db.Uuid

  type_acteur TypeActeurPresence
  code        String             @db.VarChar(30) // "standard", "premium", "corporate"
  libelle     String             @db.VarChar(100)
  rang        Int // 1 = le plus bas, unique par type d'acteur
  actif       Boolean            @default(true) // vendable ; n'affecte PAS les abonnés en cours

  // Drapeaux d'avantages APPLIQUÉS (selon le type d'acteur)
  contact_direct          Boolean @default(true) // téléphone / bouton d'appel
  photos                  Boolean @default(true) // photo de la fiche
  description_enrichie    Boolean @default(true) // description, services, biographie
  presentation_equipe     Boolean @default(false) // centres de santé
  prise_rdv_en_ligne      Boolean @default(true) // médecins
  // Statistiques de consultation (compteur VueFiche) restituées au
  // gestionnaire : totaux, et série par jour si « détaillées ».
  statistiques            Boolean @default(false)
  statistiques_detaillees Boolean @default(false)
  // RÉSERVÉS : stockés, sans effet tant que le modèle de données manque.
  multimedia              Boolean @default(false)
  multi_utilisateurs      Boolean @default(false)
  support_prioritaire     Boolean @default(false)

  // Quotas (null = illimité) — réservés
  max_photos        Int?
  max_gestionnaires Int?

  abonnements AbonnementPresence[]
  tarifs      TarifAbonnementPresence[]

  @@unique([type_acteur, code])
  @@unique([type_acteur, rang])
  @@map("niveau_abonnement_presence")
}

model AbonnementPresence {
  abonnement_id String @id @default(uuid()) @db.Uuid

  type_acteur  TypeActeurPresence
  // Exactement une des trois, celle du type_acteur (CHECK SQL).
  pharmacie_id String?            @db.Uuid
  structure_id String?            @db.Uuid
  medecin_id   String?            @db.Uuid
  niveau_id    String             @db.Uuid

  // Figés à la création du brouillon (jamais rétroactif).
  duree_mois            Int
  prix_mensuel_applique Decimal @db.Decimal(12, 2)
  remise_pourcent       Decimal @default(0) @db.Decimal(5, 2)
  credit_prorata        Decimal @default(0) @db.Decimal(12, 2)
  montant_total         Decimal @db.Decimal(12, 2)
  devise                String  @db.VarChar(3)

  // date_fin EXCLUSIVE : premier jour non couvert.
  date_debut DateTime?                 @db.Date
  date_fin   DateTime?                 @db.Date
  statut     StatutAbonnementAssurance @default(en_attente_paiement)

  abonnement_remplace_id String? @db.Uuid
  dernier_rappel_jours   Int?

  transaction_id String?                    @db.Uuid
  motif          String?                    @db.Text
  origine        OrigineAbonnementAssurance @default(self_service)

  date_creation    DateTime @default(now())
  date_mise_a_jour DateTime @updatedAt

  pharmacie   Pharmacie?                 @relation(fields: [pharmacie_id], references: [pharmacie_id])
  structure   StructureSante?            @relation(fields: [structure_id], references: [structure_id])
  medecin     Medecin?                   @relation(fields: [medecin_id], references: [medecin_id])
  niveau      NiveauAbonnementPresence   @relation(fields: [niveau_id], references: [niveau_id])
  transaction TransactionPaiement?       @relation(fields: [transaction_id], references: [transaction_id])
  facture     FactureAbonnementPresence?

  @@index([pharmacie_id, statut])
  @@index([structure_id, statut])
  @@index([medecin_id, statut])
  @@index([type_acteur, statut, date_fin])
  @@index([niveau_id])
  @@index([transaction_id])
  @@map("abonnement_presence")
}

// Grille de prix : niveau (donc type d'acteur) × pays.
model TarifAbonnementPresence {
  tarif_id           String   @id @default(uuid()) @db.Uuid
  niveau_id          String   @db.Uuid
  pays_id            String   @db.Uuid
  devise             String   @db.VarChar(3)
  prix_mensuel       Decimal  @db.Decimal(12, 2)
  prix_usd_indicatif Decimal? @db.Decimal(12, 2)
  actif              Boolean  @default(true)

  niveau NiveauAbonnementPresence @relation(fields: [niveau_id], references: [niveau_id])
  pays   Pays                     @relation(fields: [pays_id], references: [pays_id])

  @@unique([niveau_id, pays_id])
  @@index([pays_id])
  @@map("tarif_abonnement_presence")
}

model RemiseDureeAbonnementPresence {
  type_acteur     TypeActeurPresence
  duree_mois      Int // 1, 3, 6, 12
  remise_pourcent Decimal            @db.Decimal(5, 2)

  @@id([type_acteur, duree_mois])
  @@map("remise_duree_abonnement_presence")
}

// Par type d'acteur et par pays : gratuité d'amorçage, grâce et, pour les
// médecins, obligation de souscrire (EF-ADM-03). Gratuité active : TOUTES
// les fiches publiées du pays reçoivent les droits du niveau offert, sans
// souscription, jusqu'à gratuite_jusqu_au inclus (ou sans fin).
model ConfigAbonnementPresence {
  type_acteur            TypeActeurPresence
  pays_id                String             @db.Uuid
  gratuite_active        Boolean            @default(false)
  gratuite_niveau_id     String?            @db.Uuid
  gratuite_jusqu_au      DateTime?          @db.Date
  grace_jours            Int                @default(7)
  // Lu pour les médecins uniquement. false : le médecin a tous les droits
  // sans abonnement (la souscription ne lui est pas proposée).
  abonnement_obligatoire Boolean            @default(false)

  pays Pays @relation(fields: [pays_id], references: [pays_id])

  @@id([type_acteur, pays_id])
  @@map("config_abonnement_presence")
}

// Facture archivée (ajout seul). Numéro tiré du même compteur que les
// abonnements assurance (même nature : abonnement de présence).
model FactureAbonnementPresence {
  facture_id     String   @id @default(uuid()) @db.Uuid
  numero         String   @unique @db.VarChar(30)
  abonnement_id  String   @unique @db.Uuid
  transaction_id String   @unique @db.Uuid
  date_emission  DateTime @default(now())
  devise         String   @db.VarChar(3)
  total          Decimal  @db.Decimal(12, 2)
  snapshot       Json

  abonnement AbonnementPresence @relation(fields: [abonnement_id], references: [abonnement_id])

  @@map("facture_abonnement_presence")
}

// ---------------------------------------------------------------------
// Statistiques de consultation des fiches (pharmacies, centres, médecins)
//
// VueFiche : agrégat par fiche et par jour UTC (vues + visiteurs uniques).
// VueFicheVisiteur : empreinte HMAC NON réversible du visiteur (jamais
// d'IP ni d'identifiant en clair), pour dédoublonner : un visiteur compte
// une fois par jour, et une nouvelle vue au plus toutes les 30 minutes.
// Purgée chaque nuit (seule la veille est conservée). acteur_id sans clé
// étrangère (fiche polymorphe, comme les journaux) — voir
// services/vuesFiche.service.js.
// ---------------------------------------------------------------------
model VueFiche {
  type_acteur TypeActeurPresence
  acteur_id   String             @db.Uuid
  jour        DateTime           @db.Date
  vues        Int                @default(0)
  visiteurs   Int                @default(0)

  @@id([type_acteur, acteur_id, jour])
  @@index([type_acteur, jour])
  @@map("vue_fiche")
}

model VueFicheVisiteur {
  type_acteur  TypeActeurPresence
  acteur_id    String             @db.Uuid
  jour         DateTime           @db.Date
  empreinte    String             @db.VarChar(64)
  derniere_vue DateTime

  @@id([type_acteur, acteur_id, jour, empreinte])
  @@index([jour])
  @@map("vue_fiche_visiteur")
}

// ---------------------------------------------------------------------
// Engagements sur la fiche publique d'un médecin (tableau de bord du
// portail médecin) : clic « Prendre rendez-vous », contact, itinéraire,
// partage, lecture des avis. Même principe que VueFiche : agrégat par
// jour UTC, chaque visiteur compte au plus UNE fois par jour et par type
// (empreinte HMAC non réversible, purgée chaque nuit). Voir
// services/engagementMedecin.service.js.
// ---------------------------------------------------------------------
enum TypeEngagementMedecin {
  clic_rdv
  clic_contact
  clic_itineraire
  partage
  lecture_avis
}

model EngagementMedecin {
  medecin_id String                @db.Uuid
  jour       DateTime              @db.Date
  type       TypeEngagementMedecin
  nombre     Int                   @default(0)

  medecin Medecin @relation(fields: [medecin_id], references: [medecin_id], onDelete: Cascade)

  @@id([medecin_id, jour, type])
  @@index([jour])
  @@map("engagement_medecin")
}

model EngagementMedecinVisiteur {
  medecin_id String                @db.Uuid
  jour       DateTime              @db.Date
  type       TypeEngagementMedecin
  empreinte  String                @db.VarChar(64)

  @@id([medecin_id, jour, type, empreinte])
  @@index([jour])
  @@map("engagement_medecin_visiteur")
}

// ===========================================================================
// RDV ALÉATOIRE (terme technique : RDV sur offre)
// ===========================================================================
// Le patient ne choisit pas de médecin : il publie une OFFRE (spécialité,
// pays + ville, jour et heure souhaités, type de RDV, motif). Elle est
// signalée à tous les médecins publiés de cette spécialité, de ce pays et de
// cette ville. Chaque médecin peut y RÉPONDRE, avec ses paramètres de profil
// (tarif indicatif, téléconsultation…) : aucune saisie sur mesure, et l'heure
// est celle du patient. Le patient compare les profils des répondants et
// « valide » l'un d'eux : un RDV classique (« cree ») est créé à la date de
// l'offre, puis le patient paie (même flux, même délai de confirmation).
//
// Statut de l'offre :
//   - ouverte   : visible des médecins éligibles, réponses possibles ;
//   - attribuee : un médecin a été validé, le RDV `rdv_id` est créé. Si ce
//                 RDV est annulé AVANT paiement (délai de confirmation expiré
//                 ou annulation du patient), l'offre REDEVIENT « ouverte »
//                 (rdv_id effacé) tant que sa date n'est pas passée ;
//   - expiree   : la date souhaitée est passée sans médecin validé (cron) ;
//   - annulee   : retirée par le patient.
enum StatutOffreRdv {
  ouverte
  attribuee
  expiree
  annulee
}

// Statut d'une réponse de médecin :
//   - proposee : en attente du choix du patient ;
//   - retiree  : le médecin a retiré sa réponse (offre encore ouverte) ;
//   - retenue  : le patient a validé ce médecin (repasse « proposee » si le
//                RDV est annulé avant paiement et que l'offre est rouverte).
enum StatutReponseOffreRdv {
  proposee
  retiree
  retenue
}

model OffreRdv {
  offre_id String @id @default(uuid()) @db.Uuid

  patient_id     String         @db.Uuid
  specialite_id  String         @db.Uuid
  pays_id        String         @db.Uuid
  ville_id       String         @db.Uuid
  type_rdv       TypeRdv
  // Instant réel choisi par le patient (jour + heure) : ce sera
  // RendezVous.date_creneau. Aucune modification par le médecin.
  date_souhaitee DateTime
  motif          String?        @db.Text
  statut         StatutOffreRdv @default(ouverte)

  // RDV issu de la validation (statut « attribuee »). Effacé si le RDV est
  // annulé avant paiement et que l'offre est rouverte.
  rdv_id String? @unique @db.Uuid

  date_creation   DateTime  @default(now())
  date_annulation DateTime?

  patient     Patient     @relation(fields: [patient_id], references: [patient_id])
  specialite  Specialite  @relation(fields: [specialite_id], references: [specialite_id])
  pays        Pays        @relation(fields: [pays_id], references: [pays_id])
  ville       Ville       @relation(fields: [ville_id], references: [ville_id])
  rendez_vous RendezVous? @relation(fields: [rdv_id], references: [rdv_id])

  reponses ReponseOffreRdv[]

  @@index([patient_id])
  @@index([statut, specialite_id, ville_id])
  @@index([date_souhaitee])
  @@map("offre_rdv")
}

model ReponseOffreRdv {
  reponse_id String @id @default(uuid()) @db.Uuid

  offre_id   String                @db.Uuid
  medecin_id String                @db.Uuid
  // Mot facultatif du médecin au patient (ex. « disponible, cabinet à
  // Bonapriso »). Le tarif n'est JAMAIS saisi ici : c'est celui du profil.
  message    String?               @db.VarChar(500)
  statut     StatutReponseOffreRdv @default(proposee)

  date_creation DateTime  @default(now())
  date_retrait  DateTime?

  offre   OffreRdv @relation(fields: [offre_id], references: [offre_id], onDelete: Cascade)
  medecin Medecin  @relation(fields: [medecin_id], references: [medecin_id])

  // Une seule réponse par médecin et par offre (un retrait puis une
  // nouvelle réponse réactive la même ligne).
  @@unique([offre_id, medecin_id])
  @@index([medecin_id])
  @@map("reponse_offre_rdv")
}

// -----------------------------------------------------------------
// WhatsApp — socle d'envoi (API WhatsApp Cloud de Meta).
//
// NumeroWhatsapp : numéro(s) EXPÉDITEUR d'APS Santé, gérés depuis le
// back-office. Un seul numéro actif à la fois (index unique PARTIEL
// déclaré dans la migration) : c'est lui qu'utilise tout envoi. Le
// jeton d'accès Meta n'est PAS stocké ici (secret, variable
// d'environnement WHATSAPP_ACCESS_TOKEN) : seuls les identifiants
// publics du numéro le sont.
//
// MessageWhatsapp : journal de chaque envoi (une ligne par message),
// écrit par whatsapp.service.js — point unique d'envoi. `cle` (facultative)
// rend un envoi idempotent : même événement + même destinataire = un
// seul message, quel que soit le nombre d'appels.
// -----------------------------------------------------------------
enum StatutMessageWhatsapp {
  en_attente // ligne créée, appel à Meta en cours (ou interrompu)
  envoye // accepté par Meta (identifiant_fournisseur renseigné)
  echec // refusé ou injoignable ; `relancable` dit si le job peut réessayer
}

enum TypeMessageWhatsapp {
  texte // message libre : n'est délivré que dans les 24 h suivant un message du destinataire
  modele // modèle (template) approuvé par Meta : seul moyen d'initier une conversation
}

model NumeroWhatsapp {
  numero_whatsapp_id String @id @default(uuid()) @db.Uuid

  libelle         String  @db.VarChar(100)
  // Format international sans « + » (ex. 237690000000).
  numero          String  @unique @db.VarChar(20)
  // Identifiant du numéro dans WhatsApp Business (Meta > WhatsApp > Configuration de l'API).
  phone_number_id String  @unique @db.VarChar(40)
  // Identifiant du compte WhatsApp Business (WABA), facultatif.
  waba_id         String? @db.VarChar(40)
  actif           Boolean @default(false)

  date_creation    DateTime @default(now())
  date_mise_a_jour DateTime @updatedAt

  messages MessageWhatsapp[]

  @@map("numero_whatsapp")
}

// ModeleMessageWhatsapp : textes des notifications WhatsApp éditables au
// back-office (ex. publicité acceptée / rejetée / payée), avec variables
// {nom}. Envoyés en texte libre, ou via un modèle Meta approuvé dont le
// corps reçoit le texte rendu en paramètre {{1}} (nom_modele_meta).
model ModeleMessageWhatsapp {
  code             String   @id @db.VarChar(60)
  libelle          String   @db.VarChar(150)
  texte            String   @db.Text
  nom_modele_meta  String?  @db.VarChar(512)
  langue           String   @default("fr") @db.VarChar(10)
  actif            Boolean  @default(true)
  date_mise_a_jour DateTime @updatedAt

  @@map("modele_message_whatsapp")
}

model MessageWhatsapp {
  message_whatsapp_id String @id @default(uuid()) @db.Uuid

  // Idempotence (ex. « rdv_accepte:<rdv_id>:<utilisateur_id> »).
  cle                     String?               @unique @db.VarChar(200)
  // Service émetteur (ex. « rdv_accepte », « test_back_office »).
  origine                 String                @db.VarChar(60)
  // Numéro expéditeur réellement utilisé (null si aucun n'était actif).
  numero_whatsapp_id      String?               @db.Uuid
  // Destinataire, format international sans « + ».
  destinataire            String                @db.VarChar(20)
  utilisateur_id          String?               @db.Uuid
  type                    TypeMessageWhatsapp
  // texte : { texte } ; modele : { nom, langue, composants }
  contenu                 Json
  statut                  StatutMessageWhatsapp @default(en_attente)
  // Identifiant Meta du message (wamid…).
  identifiant_fournisseur String?               @db.VarChar(128)
  erreur_code             String?               @db.VarChar(40)
  erreur                  String?               @db.Text
  relancable              Boolean               @default(false)
  tentatives              Int                   @default(0)

  date_creation DateTime  @default(now())
  date_envoi    DateTime?

  numero      NumeroWhatsapp? @relation(fields: [numero_whatsapp_id], references: [numero_whatsapp_id], onDelete: SetNull)
  utilisateur Utilisateur?    @relation(fields: [utilisateur_id], references: [utilisateur_id], onDelete: SetNull)

  @@index([statut, relancable])
  @@index([utilisateur_id])
  @@index([date_creation])
  @@map("message_whatsapp")
}

// =====================================================================
// SMS (Twilio) — socle d'envoi et codes de vérification
//
// Les identifiants Twilio restent en variables d'environnement
// (TWILIO_*) : aucune donnée secrète en base. Tout envoi passe par
// services/sms.service.js ; les codes par verificationTelephone.service.js.
// =====================================================================

enum StatutMessageSms {
  en_attente // ligne créée, appel à Twilio en cours (ou interrompu)
  envoye // accepté par Twilio (identifiant_fournisseur = SM…)
  delivre // remise confirmée par l'opérateur (rappel de statut Twilio)
  echec // refusé, injoignable ou non délivré ; `relancable` dit si le job peut réessayer
  simule // SMS_MODE=test : rien n'est parti, le texte est affiché dans la console du serveur
}

model MessageSms {
  message_sms_id String @id @default(uuid()) @db.Uuid

  // Idempotence (ex. « rdv_rappel:<rdv_id>:<utilisateur_id> »).
  cle                     String?          @unique @db.VarChar(200)
  // Service émetteur (ex. « code_verification », « test_back_office »).
  origine                 String           @db.VarChar(60)
  // Destinataire, format international sans « + ».
  destinataire            String           @db.VarChar(20)
  utilisateur_id          String?          @db.Uuid
  // Texte envoyé. Pour un code de vérification, le code est MASQUÉ ici.
  texte                   String           @db.Text
  statut                  StatutMessageSms @default(en_attente)
  // Identifiant Twilio du message (SM…), pour le rappel de statut.
  identifiant_fournisseur String?          @unique @db.VarChar(64)
  // Nombre de segments facturés (160 caractères GSM-7, 70 en Unicode).
  segments                Int?
  erreur_code             String?          @db.VarChar(40)
  erreur                  String?          @db.Text
  relancable              Boolean          @default(false)
  tentatives              Int              @default(0)

  date_creation DateTime  @default(now())
  date_envoi    DateTime?
  date_statut   DateTime?

  utilisateur Utilisateur?       @relation(fields: [utilisateur_id], references: [utilisateur_id], onDelete: SetNull)
  codes       CodeVerification[]

  @@index([statut, relancable])
  @@index([utilisateur_id])
  @@index([date_creation])
  @@map("message_sms")
}

enum ObjetCodeVerification {
  inscription
  connexion
  reinitialisation_mot_de_passe
  changement_telephone
}

enum CanalCodeVerification {
  sms
  whatsapp
}

// Code à usage unique envoyé pour prouver la possession d'un numéro.
// Jamais stocké en clair (HMAC). Une fois vérifié, la ligne sert de
// « preuve » que le service métier (inscription…) consomme une seule fois.
model CodeVerification {
  code_verification_id String @id @default(uuid()) @db.Uuid

  // Format international sans « + ».
  telephone      String                @db.VarChar(20)
  objet          ObjetCodeVerification
  canal          CanalCodeVerification
  code_hache     String                @db.VarChar(64)
  tentatives     Int                   @default(0)
  expire_le      DateTime
  verifie_le     DateTime?
  consomme_le    DateTime?
  adresse_ip     String?               @db.VarChar(45)
  message_sms_id String?               @db.Uuid

  date_creation DateTime @default(now())

  message_sms MessageSms? @relation(fields: [message_sms_id], references: [message_sms_id], onDelete: SetNull)

  @@index([telephone, objet, date_creation])
  @@index([adresse_ip, date_creation])
  @@map("code_verification")
}

// =====================================================================
// Connexion web validée depuis l'application mobile
//
// Le navigateur demande une connexion pour un numéro ; l'application
// (déjà connectée) affiche la demande et l'utilisateur choisit le code
// affiché par le navigateur parmi trois (anti-validation par réflexe).
// Le navigateur sonde avec un secret (haché ici) et reçoit la session
// une seule fois. Numéro inconnu : demande « leurre » sans utilisateur,
// même réponse (pas d'énumération des comptes).
// =====================================================================

enum StatutDemandeConnexionWeb {
  en_attente
  approuvee
  refusee
  consommee
}

model DemandeConnexionWeb {
  demande_connexion_id String @id @default(uuid()) @db.Uuid

  utilisateur_id      String?                   @db.Uuid
  secret_hache        String                    @db.VarChar(64)
  code_correspondance String                    @db.VarChar(2)
  // Trois codes proposés dans l'application (dont le bon), ex. « 12,47,83 ».
  codes_proposes      String                    @db.VarChar(20)
  statut              StatutDemandeConnexionWeb @default(en_attente)
  user_agent          String?                   @db.VarChar(255)
  adresse_ip          String?                   @db.VarChar(45)
  expire_le           DateTime
  date_decision       DateTime?

  date_creation DateTime @default(now())

  utilisateur Utilisateur? @relation(fields: [utilisateur_id], references: [utilisateur_id], onDelete: Cascade)

  @@index([utilisateur_id, statut, expire_le])
  @@index([date_creation])
  @@map("demande_connexion_web")
}

// -----------------------------------------------------------------
// MessageContact : messages reçus via le formulaire public
// « Contactez-nous » (site web), traités depuis le back-office.
// -----------------------------------------------------------------
enum StatutMessageContact {
  nouveau
  en_cours
  traite
}

model MessageContact {
  message_contact_id String @id @default(uuid()) @db.Uuid

  nom       String  @db.VarChar(150)
  email     String? @db.VarChar(255)
  telephone String? @db.VarChar(30)
  // patient | professionnel | structure | pharmacie | assurance | annonceur | autre
  profil    String  @db.VarChar(30)
  // question | rendez_vous | paiement | partenariat | publicite | technique | donnees | autre
  sujet     String  @db.VarChar(30)
  message   String  @db.Text

  // Compte connecté au moment de l'envoi (facultatif).
  utilisateur_id String? @db.Uuid

  statut          StatutMessageContact @default(nouveau)
  note_interne    String?              @db.Text
  traite_par_id   String?              @db.Uuid
  date_creation   DateTime             @default(now())
  date_traitement DateTime?

  @@index([statut, date_creation])
  @@map("message_contact")
}
